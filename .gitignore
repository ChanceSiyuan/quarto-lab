# 忽略生成文件夹
.quarto/
_site/
site_libs/
_server/
_freeze/
_resource/
/work/
/drafts/.preview/
# 忽略 Jupyter 缓存
.ipynb_checkpoints/
__pycache__/
.jupyter_cache

# 忽略 Mac 系统文件
.DS_Store

# 忽略敏感信息 (如果有)
.env
venv
.venv/
/.quarto/

# 忽略生成的 JSON 文件
**/index-listing.json

**/*.quarto_ipynb

/.luarc.json
.aider*

# Knowledge bases (download-ref / survey / advisors): raw PDFs and extracted
# figures stay local ("**" also matches zero dirs, so .knowledge/.raw/ is covered)
.knowledge/**/.raw/
.knowledge/**/.figures/
advisors/**/.raw/
advisors/**/.figures/

# State/log artifacts from automated review scripts
.polish_state/
.review_state/
.noisy_gen_state/
*.log

# Installed skill copies (generated by scripts/install_skills.sh from Ion.toml;
# local sources live in skills/, third-party versions are pinned in Ion.lock).
# .claude/skills is read by Claude Code; .agents/skills natively by Codex.
.claude/skills/
.agents/

# Managed by ion
.agents/skills/ion-cli
.claude/skills/ion-cli
.agents/skills/arxiv-search
.claude/skills/arxiv-search
.agents/skills/context7-cli
.claude/skills/context7-cli
.agents/skills/idea-writer
.claude/skills/idea-writer
.agents/skills/ideas
.claude/skills/ideas
.agents/skills/paper-writer
.claude/skills/paper-writer
.agents/skills/researchstyle
.claude/skills/researchstyle
.agents/skills/review-writer
.claude/skills/review-writer
.agents/skills/scientific-visualization
.claude/skills/scientific-visualization
.agents/skills/survey
.claude/skills/survey
