@misc{kempeComplexityLocalHamiltonian2005,
	title = {The {Complexity} of the {Local} {Hamiltonian} {Problem}},
	url = {http://arxiv.org/abs/quant-ph/0406180},
	abstract = {The k-local Hamiltonian problem is a natural complete problem for the complexity class QMA, the quantum analog of NP. It is similar in spirit to MAX-k-SAT, which is NP-complete for k{\textless}=2. It was known that the problem is QMA-complete for any k {\textless}= 3. On the other hand 1-local Hamiltonian is in P, and hence not believed to be QMA-complete. The complexity of the 2-local Hamiltonian problem has long been outstanding. Here we settle the question and show that it is QMA-complete. We provide two independent proofs; our first proof uses only elementary linear algebra. Our second proof uses a powerful technique for analyzing the sum of two Hamiltonians; this technique is based on perturbation theory and we believe that it might prove useful elsewhere. Using our techniques we also show that adiabatic computation with two-local interactions on qubits is equivalent to standard quantum computation.},
	urldate = {2024-06-29},
	publisher = {arXiv},
	author = {Kempe, Julia and Kitaev, Alexei and Regev, Oded},
	month = oct,
	year = {2005},
	note = {arXiv:quant-ph/0406180},
	annote = {Comment: 30 pages, 3 figures, replaced with revised version, numerous improvements to readability and expanded adiabatic section},
