	title = {Quantum {Advantage} via {Efficient} {Post}-processing on {Qudit} {Classical} {Shadow} tomography},
	volume = {135},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/2408.16244},
	doi = {10.1103/92ky-ln8f},
	abstract = {The computation of {\textbackslash}({\textbackslash}operatorname\{tr\}(AB){\textbackslash}) is essential in quantum science and artificial intelligence, yet classical methods for {\textbackslash}( d {\textbackslash})-dimensional matrices {\textbackslash}( A {\textbackslash}) and {\textbackslash}( B {\textbackslash}) require {\textbackslash}( O(d{\textasciicircum}2) {\textbackslash}) complexity, which becomes infeasible for exponentially large systems. We introduce a quantum approach based on qudit shadow tomography that reduces both computational and storage complexities to {\textbackslash}( O({\textbackslash}text\{poly\}({\textbackslash}log d)) {\textbackslash}) in specific cases. The proposed method applies to quantum density matrices {\textbackslash}( A {\textbackslash}) and Hermitian matrices {\textbackslash}( B {\textbackslash}) with given {\textbackslash}({\textbackslash}operatorname\{tr\}(B){\textbackslash}) and {\textbackslash}({\textbackslash}operatorname\{tr\}(B{\textasciicircum}2){\textbackslash}) bounded by a constant (referred to as BN-observables). It guarantees at least a quadratic speedup ({\textbackslash}(O(d{\textasciicircum}2) {\textbackslash}to O(d){\textbackslash})) in the worst case and achieves exponential speedup for approximately average cases. For any {\textbackslash}( n {\textbackslash})-qubit stabilizer state {\textbackslash}(ρ{\textbackslash}) and arbitrary BN-observable {\textbackslash}( O {\textbackslash}), we show that {\textbackslash}({\textbackslash}operatorname\{tr\}(ρO){\textbackslash}) can be efficiently estimated with {\textbackslash}({\textbackslash}text\{poly\}(n){\textbackslash}) computations. Moreover, our approach significantly reduces the post-processing complexity in shadow tomography using random Clifford measurements, and it is applicable to arbitrary dimensions {\textbackslash}( d {\textbackslash}). These advances open new avenues for efficient high-dimensional data analysis and modeling.},
	number = {20},
	urldate = {2025-12-21},
	journal = {Physical Review Letters},
	author = {Wang, Yu},
	month = nov,
	year = {2025},
	note = {arXiv:2408.16244 [quant-ph]},
