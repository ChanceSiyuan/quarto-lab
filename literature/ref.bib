  keywords = {zotero}
}

@misc{grewalEfficientLearningStructured2026,
	title = {Efficient {Learning} of {Structured} {Quantum} {Circuits} via {Pauli} {Dimensionality} and {Sparsity}},
	url = {http://arxiv.org/abs/2510.00168},
	doi = {10.48550/arXiv.2510.00168},
	abstract = {We study the problem of efficiently learning an unknown \$n\$-qubit unitary channel in diamond distance given query access. We present a general framework showing that if Pauli operators remain low-complexity under conjugation by a unitary, then the unitary can be learned efficiently. This framework yields polynomial-time algorithms for a wide range of circuit classes, including \$O({\textbackslash}log {\textbackslash}log n)\$-depth circuits, quantum \$O({\textbackslash}log n)\$-juntas, near-Clifford circuits, the Clifford hierarchy, fermionic matchgate circuits, and certain compositions thereof. Our results unify and generalize prior work, and yield efficient learning algorithms for more expressive circuit classes than were previously known. Our framework is powered by new learning algorithms for unitaries whose Pauli spectrum is either supported on a small subgroup or is sparse. If the Pauli spectrum is supported on a subgroup of size \$2{\textasciicircum}k\$, we give an \${\textbackslash}widetilde\{O\}(2{\textasciicircum}k/ε)\$-query algorithm and a nearly matching \$Ω(2{\textasciicircum}k/ε)\$ lower bound. For \$k = 2n\$, we recover the optimal \$O(4{\textasciicircum}n/ε)\$-query algorithm of Haah, Kothari, O'Donnell, and Tang [FOCS '23]. If the Pauli spectrum is supported on \$s\$ Pauli operators, we give an \$O(s{\textasciicircum}2/ε{\textasciicircum}2)\$-query algorithm and an \$Ω(s/ε)\$ lower bound.},
	urldate = {2026-06-30},
	publisher = {arXiv},
	author = {Grewal, Sabee and Liang, Daniel},
	month = apr,
	year = {2026},
	note = {arXiv:2510.00168 [quant-ph]},
	annote = {Comment: 46 pages; added new results; overhauled presentation of the paper; title changed},
  keywords = {zotero}
}

@misc{grewalImprovedStabilizerEstimation2024,
	title = {Improved {Stabilizer} {Estimation} via {Bell} {Difference} {Sampling}},
	url = {http://arxiv.org/abs/2304.13915},
	abstract = {We study the complexity of learning quantum states in various models with respect to the stabilizer formalism and obtain the following results: - We prove that \${\textbackslash}Omega(n)\$ \$T\$-gates are necessary for any Clifford+\$T\$ circuit to prepare computationally pseudorandom quantum states, an exponential improvement over the previously known bound. This bound is asymptotically tight if linear-time quantum-secure pseudorandom functions exist. - Given an \$n\$-qubit pure quantum state \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ that has fidelity at least \${\textbackslash}tau\$ with some stabilizer state, we give an algorithm that outputs a succinct description of a stabilizer state that witnesses fidelity at least \${\textbackslash}tau - {\textbackslash}varepsilon\$. The algorithm uses \$O(n/({\textbackslash}varepsilon{\textasciicircum}2{\textbackslash}tau{\textasciicircum}4))\$ samples and \${\textbackslash}exp{\textbackslash}left(O(n/{\textbackslash}tau{\textasciicircum}4){\textbackslash}right) / {\textbackslash}varepsilon{\textasciicircum}2\$ time. In the regime of \${\textbackslash}tau\$ constant, this algorithm estimates stabilizer fidelity substantially faster than the na{\textbackslash}"ive \${\textbackslash}exp(O(n{\textasciicircum}2))\$-time brute-force algorithm over all stabilizer states. - In the special case of \${\textbackslash}tau {\textgreater} {\textbackslash}cos{\textasciicircum}2({\textbackslash}pi/8)\$, we show that a modification of the above algorithm runs in polynomial time. - We exhibit a tolerant property testing algorithm for stabilizer states. The underlying algorithmic primitive in all of our results is Bell difference sampling. To prove our results, we establish and/or strengthen connections between Bell difference sampling, symplectic Fourier analysis, and graph theory.},
	urldate = {2024-07-20},
	publisher = {arXiv},
	author = {Grewal, Sabee and Iyer, Vishnu and Kretschmer, William and Liang, Daniel},
	month = mar,
	year = {2024},
	note = {arXiv:2304.13915 [quant-ph]},
	annote = {Comment: 41 pages, 2 figures. v3: changed presentation of tolerant testing algorithm and other minor edits},
  keywords = {zotero}
