@article{yuStatisticalMethodsQuantum2022,
	title = {Statistical {Methods} for {Quantum} {State} {Verification} and {Fidelity} {Estimation}},
	volume = {5},
	issn = {2511-9044, 2511-9044},
	url = {http://arxiv.org/abs/2109.10805},
