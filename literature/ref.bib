@article{keylQuantumStateEstimation2006,
	title = {Quantum state estimation and large deviations},
	volume = {18},
	issn = {0129-055X, 1793-6659},
	url = {http://arxiv.org/abs/quant-ph/0412053},
	doi = {10.1142/S0129055X06002565},
	abstract = {In this paper we propose a method to estimate the density matrix {\textbackslash}rho of a d-level quantum system by measurements on the N-fold system. The scheme is based on covariant observables and representation theory of unitary groups and it extends previous results concerning the estimation of the spectrum of {\textbackslash}rho. We show that it is consistent (i.e. the original input state {\textbackslash}rho is recovered with certainty if N {\textbackslash}to {\textbackslash}infty), analyze its large deviation behavior, and calculate explicitly the corresponding rate function which describes the exponential decrease of error probabilities in the limit N {\textbackslash}to {\textbackslash}infty. Finally we discuss the question whether the proposed scheme provides the fastest possible decay of error probabilities.},
