@misc{grewalAgnosticTomographyStabilizer2024,
	title = {Agnostic {Tomography} of {Stabilizer} {Product} {States}},
	url = {http://arxiv.org/abs/2404.03813},
	abstract = {We define a quantum learning task called agnostic tomography, where given copies of an arbitrary state \${\textbackslash}rho\$ and a class of quantum states \${\textbackslash}mathcal\{C\}\$, the goal is to output a succinct description of a state that approximates \${\textbackslash}rho\$ at least as well as any state in \${\textbackslash}mathcal\{C\}\$ (up to some small error \${\textbackslash}varepsilon\$). This task generalizes ordinary quantum tomography of states in \${\textbackslash}mathcal\{C\}\$ and is more challenging because the learning algorithm must be robust to perturbations of \${\textbackslash}rho\$. We give an efficient agnostic tomography algorithm for the class \${\textbackslash}mathcal\{C\}\$ of \$n\$-qubit stabilizer product states. Assuming \${\textbackslash}rho\$ has fidelity at least \${\textbackslash}tau\$ with a stabilizer product state, the algorithm runs in time \$n{\textasciicircum}\{O(1 + {\textbackslash}log(1/{\textbackslash}tau))\} / {\textbackslash}varepsilon{\textasciicircum}2\$. This runtime is quasipolynomial in all parameters, and polynomial if \${\textbackslash}tau\$ is a constant.},
	urldate = {2024-08-15},
	publisher = {arXiv},
	author = {Grewal, Sabee and Iyer, Vishnu and Kretschmer, William and Liang, Daniel},
	month = apr,
	year = {2024},
	note = {arXiv:2404.03813 [quant-ph]},
	annote = {Comment: 20 pages},
  keywords = {zotero}
}

@misc{grewalEfficientLearningQuantum2024,
	title = {Efficient {Learning} of {Quantum} {States} {Prepared} {With} {Few} {Non}-{Clifford} {Gates}},
	url = {http://arxiv.org/abs/2305.13409},
	abstract = {We give a pair of algorithms that efficiently learn a quantum state prepared by Clifford gates and \$O({\textbackslash}log n)\$ non-Clifford gates. Specifically, for an \$n\$-qubit state \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ prepared with at most \$t\$ non-Clifford gates, our algorithms use \${\textbackslash}mathsf\{poly\}(n,2{\textasciicircum}t,1/{\textbackslash}varepsilon)\$ time and copies of \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ to learn \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ to trace distance at most \${\textbackslash}varepsilon\$. The first algorithm for this task is more efficient, but requires entangled measurements across two copies of \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$. The second algorithm uses only single-copy measurements at the cost of polynomial factors in runtime and sample complexity. Our algorithms more generally learn any state with sufficiently large stabilizer dimension, where a quantum state has stabilizer dimension \$k\$ if it is stabilized by an abelian group of \$2{\textasciicircum}k\$ Pauli operators. We also develop an efficient property testing algorithm for stabilizer dimension, which may be of independent interest.},
	language = {en-US},
	urldate = {2024-07-20},
