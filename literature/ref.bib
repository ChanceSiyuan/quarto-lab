	annote = {Comment: Differing from the journal version, this version includes a table of contents and makes extensive use of boldface type to highlight the contents of the main theorems. It includes a self-contained introduction to the framework of general probabilistic theories and a discussion about the role of causality and local discriminability},
  keywords = {zotero}
}

@article{chitambarEverythingYouAlways2014,
	title = {Everything {You} {Always} {Wanted} to {Know} {About} {LOCC} ({But} {Were} {Afraid} to {Ask})},
