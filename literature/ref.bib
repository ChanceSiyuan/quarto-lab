@article{maoQuditShadowEstimation2025,
	title = {Qudit {Shadow} {Estimation} {Based} on the {Clifford} {Group} and the {Power} of a {Single} {Magic} {Gate}},
	volume = {134},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/2410.13572},
	doi = {10.1103/PhysRevLett.134.160801},
	abstract = {Shadow estimation is a sample-efficient protocol for learning the properties of a quantum system using randomized measurements, but the current understanding of qudit shadow estimation is quite limited compared with the qubit setting. Here we clarify the sample complexity of qudit shadow estimation based on the Clifford group, where the local dimension \$d\$ is an odd prime. Notably, we show that the overhead of qudit shadow estimation over the qubit counterpart is only \${\textbackslash}mathcal\{O\}(d)\$, independent of the qudit number \$n\$, although the set of stabilizer states may deviate exponentially from a 3-design with respect to the third moment operator. Furthermore, by adding one layer of magic gates, we propose a simple circuit that can significantly boost the efficiency. Actually, a single magic gate can already eliminate the \${\textbackslash}mathcal\{O\}(d)\$ overhead in qudit shadow estimation and bridge the gap from the qubit setting.},
	number = {16},
	urldate = {2025-12-21},
	journal = {Physical Review Letters},
	author = {Mao, Chengsi and Yi, Changhao and Zhu, Huangjun},
	month = apr,
	year = {2025},
	note = {arXiv:2410.13572 [quant-ph]},
	pages = {160801},
	annote = {Comment: 9+20 pages, 6+6 figures, and 2 tables; title updated, published in PRL. See also the companion paper "Third moments of qudit Clifford orbits and 3-designs based on magic orbits (arXiv:2410.13575)"},
  keywords = {zotero}
}

