@article{singhHighFidelityMagicStatePreparation2022,
	title = {High-{Fidelity} {Magic}-{State} {Preparation} with a {Biased}-{Noise} {Architecture}},
	volume = {105},
	issn = {2469-9926, 2469-9934},
	url = {http://arxiv.org/abs/2109.02677},
	doi = {10.1103/PhysRevA.105.052410},
	abstract = {Magic state distillation is a resource intensive subroutine that consumes noisy input states to produce high-fidelity resource states that are used to perform logical operations in practical quantum-computing architectures. The resource cost of magic state distillation can be reduced by improving the fidelity of the raw input states. To this end, we propose an initialization protocol that offers a quadratic improvement in the error rate of the input magic states in architectures with biased noise. This is achieved by preparing an error-detecting code which detects the dominant errors that occur during state preparation. We obtain this advantage by exploiting the native gate operations of an underlying qubit architecture that experiences biases in its noise profile. We perform simulations to analyze the performance of our protocol with the XZZX surface code. Even at modest physical parameters with a two-qubit gate error rate of \$0.7{\textbackslash}\%\$ and total probability of dominant errors in the gate \$O(10{\textasciicircum}3)\$ larger compared to that of non-dominant errors, we find that our preparation scheme delivers magic states with logical error rate \$O(10{\textasciicircum}\{-8\})\$ after a single round of the standard 15-to-1 distillation protocol; two orders of magnitude lower than using conventional state preparation. Our approach therefore promises considerable savings in overheads with near-term technology.},
	language = {en},
	number = {5},
	urldate = {2024-02-26},
	journal = {Physical Review A},
	author = {Singh, Shraddha and Darmawan, Andrew S. and Brown, Benjamin J. and Puri, Shruti},
	month = may,
	year = {2022},
	note = {arXiv:2109.02677 [quant-ph]},
	pages = {052410},
  keywords = {zotero}
}

@misc{singhProofofworkConsensusQuantum2024,
	title = {Proof-of-work consensus by quantum sampling},
	url = {http://arxiv.org/abs/2305.19865},
	doi = {10.48550/arXiv.2305.19865},
	abstract = {Since its advent in 2011, boson sampling has been a preferred candidate for demonstrating quantum advantage because of its simplicity and near-term requirements compared to other quantum algorithms. We propose to use a variant, called coarse-grained boson-sampling (CGBS), as a quantum Proof-of-Work (PoW) scheme for blockchain consensus. The users perform boson sampling using input states that depend on the current block information and commit their samples to the network. Afterwards, CGBS strategies are determined which can be used to both validate samples and reward successful miners. By combining rewards for miners committing honest samples together with penalties for miners committing dishonest samples, a Nash equilibrium is found that incentivizes honest nodes. We provide numerical evidence that these validation tests are hard to spoof classically without knowing the binning scheme ahead of time and show the robustness of our protocol to small partial distinguishability of photons. The scheme works for both Fock state boson sampling and Gaussian boson sampling and provides dramatic speedup and energy savings relative to computation by classical hardware.},
	urldate = {2025-02-04},
	publisher = {arXiv},
	author = {Singh, Deepesh and Muraleedharan, Gopikrishnan and Fu, Boxiang and Cheng, Chen-Mou and Newton, Nicolas Roussy and Rohde, Peter P. and Brennen, Gavin K.},
	month = sep,
	year = {2024},
