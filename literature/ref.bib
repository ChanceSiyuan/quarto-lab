@misc{ziniConformalFieldTheories2018,
	title = {Conformal {Field} {Theories} as {Scaling} {Limit} of {Anyonic} {Chains}},
	url = {http://arxiv.org/abs/1706.08497},
	doi = {10.48550/arXiv.1706.08497},
	abstract = {We provide a mathematical definition of a low energy scaling limit of a sequence of general non-relativistic quantum theories in any dimension, and apply our formalism to anyonic chains. We formulate Conjecture 4.3 on conditions when a chiral unitary rational (1+1)-conformal field theory would arise as such a limit and verify the conjecture for the Ising minimal model \$M(4,3)\$ using Ising anyonic chains. Part of the conjecture is a precise relation between Temperley-Lieb generators \${\textbackslash}\{e\_i{\textbackslash}\}\$ and some finite stage operators of the Virasoro generators \${\textbackslash}\{L\_m+L\_\{-m\}{\textbackslash}\}\$ and \${\textbackslash}\{i(L\_m-L\_\{-m\}){\textbackslash}\}\$ for unitary minimal models \$M(k+2,k+1)\$ in Conjecture 5.5. A similar earlier relation is known as the Koo-Saleur formula in the physics literature [39]. Assuming Conjecture 4.3, most of our main results for the Ising minimal model \$M(4,3)\$ hold for unitary minimal models \$M(k+2,k+1), k{\textbackslash}geq 3\$ as well. Our approach is inspired by an eventual application to an efficient simulation of conformal field theories by quantum computers, and supported by extensive numerical simulation and physical proofs in the physics literature.},
	urldate = {2026-07-26},
	publisher = {arXiv},
	author = {Zini, Modjtaba Shokrian and Wang, Zhenghan},
	month = aug,
	year = {2018},
	note = {arXiv:1706.08497 [math-ph]},
	annote = {Comment: To appear in CMP},
  keywords = {zotero}
}

@misc{ziyinNeuralNetworksFail2020,
	title = {Neural {Networks} {Fail} to {Learn} {Periodic} {Functions} and {How} to {Fix} {It}},
	url = {http://arxiv.org/abs/2006.08195},
	doi = {10.48550/arXiv.2006.08195},
	abstract = {Previous literature offers limited clues on how to learn a periodic function using modern neural networks. We start with a study of the extrapolation properties of neural networks; we prove and demonstrate experimentally that the standard activations functions, such as ReLU, tanh, sigmoid, along with their variants, all fail to learn to extrapolate simple periodic functions. We hypothesize that this is due to their lack of a "periodic" inductive bias. As a fix of this problem, we propose a new activation, namely, \$x + {\textbackslash}sin{\textasciicircum}2(x)\$, which achieves the desired periodic inductive bias to learn a periodic function while maintaining a favorable optimization property of the ReLU-based activations. Experimentally, we apply the proposed method to temperature and financial data prediction.},
	urldate = {2026-01-02},
	publisher = {arXiv},
	author = {Ziyin, Liu and Hartwig, Tilman and Ueda, Masahito},
	month = oct,
	year = {2020},
	note = {arXiv:2006.08195 [cs]},
	annote = {Comment: NeurIPS 2020 Camera Ready version},
  keywords = {zotero}
}

