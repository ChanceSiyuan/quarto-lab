  keywords = {zotero}
}

@misc{buhrmanQuantumMajorityVote2022,
	title = {Quantum majority vote},
	url = {http://arxiv.org/abs/2211.11729},
	doi = {10.48550/arXiv.2211.11729},
	abstract = {Majority vote is a basic method for amplifying correct outcomes that is widely used in computer science and beyond. While it can amplify the correctness of a quantum device with classical output, the analogous procedure for quantum output is not known. We introduce quantum majority vote as the following task: given a product state \${\textbar}{\textbackslash}psi\_1{\textbackslash}rangle {\textbackslash}otimes {\textbackslash}dots {\textbackslash}otimes {\textbar}{\textbackslash}psi\_n{\textbackslash}rangle\$ where each qubit is in one of two orthogonal states \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ or \${\textbar}{\textbackslash}psi{\textasciicircum}{\textbackslash}perp{\textbackslash}rangle\$, output the majority state. We show that an optimal algorithm for this problem achieves worst-case fidelity of \$1/2 + {\textbackslash}Theta(1/{\textbackslash}sqrt\{n\})\$. Under the promise that at least \$2/3\$ of the input qubits are in the majority state, the fidelity increases to \$1 - {\textbackslash}Theta(1/n)\$ and approaches \$1\$ as \$n\$ increases. We also consider the more general problem of computing any symmetric and equivariant Boolean function \$f: {\textbackslash}\{0,1{\textbackslash}\}{\textasciicircum}n {\textbackslash}to {\textbackslash}\{0,1{\textbackslash}\}\$ in an unknown quantum basis, and show that a generalization of our quantum majority vote algorithm is optimal for this task. The optimal parameters for the generalized algorithm and its worst-case fidelity can be determined by a simple linear program of size \$O(n)\$. The time complexity of the algorithm is \$O(n{\textasciicircum}4 {\textbackslash}log n)\$ where \$n\$ is the number of input qubits.},
	urldate = {2025-07-26},
	publisher = {arXiv},
	author = {Buhrman, Harry and Linden, Noah and Mančinska, Laura and Montanaro, Ashley and Ozols, Maris},
	month = nov,
	year = {2022},
	note = {arXiv:2211.11729 [quant-ph]},
	annote = {Comment: 85 pages, 8 figures},
  keywords = {zotero}
}

