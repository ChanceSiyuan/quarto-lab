@misc{schusterRandomUnitariesExtremely2024,
	title = {Random unitaries in extremely low depth},
	url = {http://arxiv.org/abs/2407.07754},
	abstract = {We prove that random quantum circuits on any geometry, including a 1D line, can form approximate unitary designs over \$n\$ qubits in \${\textbackslash}log n\$ depth. In a similar manner, we construct pseudorandom unitaries (PRUs) in 1D circuits in \${\textbackslash}text\{poly\} {\textbackslash}log n \$ depth, and in all-to-all-connected circuits in \${\textbackslash}text\{poly\} {\textbackslash}log {\textbackslash}log n \$ depth. In all three cases, the \$n\$ dependence is optimal and improves exponentially over known results. These shallow quantum circuits have low complexity and create only short-range entanglement, yet are indistinguishable from unitaries with exponential complexity. Our construction glues local random unitaries on \${\textbackslash}log n\$-sized or \${\textbackslash}text\{poly\} {\textbackslash}log n\$-sized patches of qubits to form a global random unitary on all \$n\$ qubits. In the case of designs, the local unitaries are drawn from existing constructions of approximate unitary \$k\$-designs, and hence also inherit an optimal scaling in \$k\$. In the case of PRUs, the local unitaries are drawn from existing unitary ensembles conjectured to form PRUs. Applications of our results include proving that classical shadows with 1D log-depth Clifford circuits are as powerful as those with deep circuits, demonstrating superpolynomial quantum advantage in learning low-complexity physical systems, and establishing quantum hardness for recognizing phases of matter with topological order.},
	urldate = {2024-07-17},
	publisher = {arXiv},
	author = {Schuster, Thomas and Haferkamp, Jonas and Huang, Hsin-Yuan},
	month = jul,
	year = {2024},
	note = {arXiv:2407.07754 [cond-mat, physics:quant-ph]},
	annote = {Comment: 12 pages, 6 figures + 46-page appendix},
  keywords = {zotero}
}

