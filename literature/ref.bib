@misc{matsumotoReverseTestCharacterization2010,
	title = {Reverse {Test} and {Characterization} of {Quantum} {Relative} {Entropy}},
	url = {http://arxiv.org/abs/1010.1030},
	abstract = {The aim of the present paper is to give axiomatic characterization of quantum relative entropy utilizing resource conversion scenario. We consider two sets of axioms: non-asymptotic and asymptotic. In the former setting, we prove that the upperbound and the lowerbund of \${\textbackslash}mathrm\{D\}{\textasciicircum}\{Q\}({\textbackslash}rho{\textbar}{\textbar}{\textbackslash}sigma) \$ is \${\textbackslash}mathrm\{D\}{\textasciicircum}\{R\}({\textbackslash}rho{\textbar}{\textbar}{\textbackslash}sigma) :={\textbackslash}mathrm\{tr\}\% {\textbackslash},{\textbackslash}rho{\textbackslash}ln{\textbackslash}sqrt\{{\textbackslash}rho\}{\textbackslash}sigma{\textasciicircum}\{-1\}{\textbackslash}sqrt\{{\textbackslash}rho\}\$ and \${\textbackslash}mathrm\{D\}({\textbackslash}rho{\textbar}{\textbar}{\textbackslash}sigma) :=\$ \${\textbackslash}mathrm\{tr\}{\textbackslash},{\textbackslash}rho({\textbackslash}ln{\textbackslash}rho-{\textbackslash}ln{\textbackslash}sigma) \$, respectively. In the latter setting, we prove uniqueness of quantum relative entropy, that is, \${\textbackslash}mathrm\{D\}{\textasciicircum}\{Q\}({\textbackslash}rho{\textbar}{\textbar}{\textbackslash}sigma) \$ should equal a constant multiple of \${\textbackslash}mathrm\{D\}({\textbackslash}rho{\textbar}{\textbar}{\textbackslash}sigma) \$. In the analysis, we define and use reverse test and asymptotic reverse test, which are natural inverse of hypothesis test.},
	language = {en},
	urldate = {2023-09-06},
	publisher = {arXiv},
	author = {Matsumoto, Keiji},
	month = oct,
