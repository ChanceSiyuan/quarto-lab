  keywords = {zotero}
}

@misc{geQuantumCircuitSynthesis2024,
	title = {Quantum {Circuit} {Synthesis} and {Compilation} {Optimization}: {Overview} and {Prospects}},
	shorttitle = {Quantum {Circuit} {Synthesis} and {Compilation} {Optimization}},
