@misc{grierInteractiveQuantumAdvantage2021,
	title = {Interactive quantum advantage with noisy, shallow {Clifford} circuits},
	url = {http://arxiv.org/abs/2102.06833},
	abstract = {Recent work by Bravyi et al. constructs a relation problem that a noisy constant-depth quantum circuit (QNC\${\textasciicircum}0\$) can solve with near certainty (probability \$1 - o(1)\$), but that any bounded fan-in constant-depth classical circuit (NC\${\textasciicircum}0\$) fails with some constant probability. We show that this robustness to noise can be achieved in the other low-depth quantum/classical circuit separations in this area. In particular, we show a general strategy for adding noise tolerance to the interactive protocols of Grier and Schaeffer. As a consequence, we obtain an unconditional separation between noisy QNC\${\textasciicircum}0\$ circuits and AC\${\textasciicircum}0[p]\$ circuits for all primes \$p {\textbackslash}geq 2\$, and a conditional separation between noisy QNC\${\textasciicircum}0\$ circuits and log-space classical machines under a plausible complexity-theoretic conjecture. A key component of this reduction is showing average-case hardness for the classical simulation tasks -- that is, showing that a classical simulation of the quantum interactive task is still powerful even if it is allowed to err with constant probability over a uniformly random input. We show that is true even for quantum tasks which are \${\textbackslash}oplus\$L-hard to simulate. To do this, we borrow techniques from randomized encodings used in cryptography.},
	urldate = {2024-07-26},
	publisher = {arXiv},
	author = {Grier, Daniel and Ju, Nathan and Schaeffer, Luke},
	month = sep,
	year = {2021},
	note = {arXiv:2102.06833 [quant-ph]},
	annote = {Comment: 33 pages (minor edits)},
  keywords = {zotero}
}

@misc{grierPrincipalEigenstateClassical2024,
	title = {Principal eigenstate classical shadows},
	url = {http://arxiv.org/abs/2405.13939},
	doi = {10.48550/arXiv.2405.13939},
	abstract = {Given many copies of an unknown quantum state \$ρ\$, we consider the task of learning a classical description of its principal eigenstate. Namely, assuming that \$ρ\$ has an eigenstate \${\textbar}φ{\textbackslash}rangle\$ with (unknown) eigenvalue \$λ{\textgreater} 1/2\$, the goal is to learn a (classical shadows style) classical description of \${\textbar}φ{\textbackslash}rangle\$ which can later be used to estimate expectation values \${\textbackslash}langle φ{\textbar}O{\textbar} φ{\textbackslash}rangle\$ for any \$O\$ in some class of observables. We consider the sample-complexity setting in which generating a copy of \$ρ\$ is expensive, but joint measurements on many copies of the state are possible. We present a protocol for this task scaling with the principal eigenvalue \$λ\$ and show that it is optimal within a space of natural approaches, e.g., applying quantum state purification followed by a single-copy classical shadows scheme. Furthermore, when \$λ\$ is sufficiently close to \$1\$, the performance of our algorithm is optimal--matching the sample complexity for pure state classical shadows.},
	urldate = {2025-12-15},
	publisher = {arXiv},
	author = {Grier, Daniel and Pashayan, Hakop and Schaeffer, Luke},
	month = may,
	year = {2024},
	note = {arXiv:2405.13939 [quant-ph]},
	annote = {Comment: 38 pages},
  keywords = {zotero}
}

@article{grierSampleoptimalClassicalShadows2024,
	title = {Sample-optimal classical shadows for pure states},
	volume = {8},
	issn = {2521-327X},
	url = {http://arxiv.org/abs/2211.11810},
	doi = {10.22331/q-2024-06-17-1373},
	abstract = {We consider the classical shadows task for pure states in the setting of both joint and independent measurements. The task is to measure few copies of an unknown pure state \${\textbackslash}rho\$ in order to learn a classical description which suffices to later estimate expectation values of observables. Specifically, the goal is to approximate \${\textbackslash}mathrm\{Tr\}(O {\textbackslash}rho)\$ for any Hermitian observable \$O\$ to within additive error \${\textbackslash}epsilon\$ provided \${\textbackslash}mathrm\{Tr\}(O{\textasciicircum}2){\textbackslash}leq B\$ and \${\textbackslash}lVert O {\textbackslash}rVert = 1\$. Our main result applies to the joint measurement setting, where we show \${\textbackslash}tilde\{{\textbackslash}Theta\}({\textbackslash}sqrt\{B\}{\textbackslash}epsilon{\textasciicircum}\{-1\} + {\textbackslash}epsilon{\textasciicircum}\{-2\})\$ samples of \${\textbackslash}rho\$ are necessary and sufficient to succeed with high probability. The upper bound is a quadratic improvement on the previous best sample complexity known for this problem. For the lower bound, we see that the bottleneck is not how fast we can learn the state but rather how much any classical description of \${\textbackslash}rho\$ can be compressed for observable estimation. In the independent measurement setting, we show that \${\textbackslash}mathcal O({\textbackslash}sqrt\{Bd\} {\textbackslash}epsilon{\textasciicircum}\{-1\} + {\textbackslash}epsilon{\textasciicircum}\{-2\})\$ samples suffice. Notably, this implies that the random Clifford measurements algorithm of Huang, Kueng, and Preskill, which is sample-optimal for mixed states, is not optimal for pure states. Interestingly, our result also uses the same random Clifford measurements but employs a different estimator.},
	urldate = {2025-11-02},
	journal = {Quantum},
	author = {Grier, Daniel and Pashayan, Hakop and Schaeffer, Luke},
	month = jun,
	year = {2024},
	note = {arXiv:2211.11810 [quant-ph]},
	pages = {1373},
	annote = {Comment: 34 pages; v2 - journal version},
  keywords = {zotero}
}

@article{griffithsSemiclassicalFourierTransform1996,
	title = {Semiclassical {Fourier} {Transform} for {Quantum} {Computation}},
	volume = {76},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/quant-ph/9511007},
	doi = {10.1103/PhysRevLett.76.3228},
	abstract = {Shor's algorithms for factorization and discrete logarithms on a quantum computer employ Fourier transforms preceding a final measurement. It is shown that such a Fourier transform can be carried out in a semi-classical way in which a ``classical'' (macroscopic) signal resulting from the measurement of one bit (embodied in a two-state quantum system) is employed to determine the type of measurement carried out on the next bit, and so forth. In this way the two-bit gates in the Fourier transform can all be replaced by a smaller number of one-bit gates controlled by classical signals. Success in simplifying the Fourier transform suggests that it may be worthwhile looking for other ways of using semi-classical methods in quantum computing.},
	number = {17},
	urldate = {2025-03-25},
	journal = {Physical Review Letters},
	author = {Griffiths, Robert B. and Niu, Chi-Sheng},
	month = apr,
	year = {1996},
