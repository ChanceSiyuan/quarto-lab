@misc{bermejo-vegaNormalizerCircuitsGottesmanKnill2015,
	title = {Normalizer circuits and a {Gottesman}-{Knill} theorem for infinite-dimensional systems},
	url = {http://arxiv.org/abs/1409.3208},
	doi = {10.48550/arXiv.1409.3208},
	abstract = {\${\textbackslash}textit\{Normalizer circuits\}\$ [1,2] are generalized Clifford circuits that act on arbitrary finite-dimensional systems \${\textbackslash}mathcal\{H\}\_\{d\_1\}{\textbackslash}otimes ... {\textbackslash}otimes {\textbackslash}mathcal\{H\}\_\{d\_n\}\$ with a standard basis labeled by the elements of a finite Abelian group \$G={\textbackslash}mathbb\{Z\}\_\{d\_1\}{\textbackslash}times... {\textbackslash}times {\textbackslash}mathbb\{Z\}\_\{d\_n\}\$. Normalizer gates implement operations associated with the group \$G\$ and can be of three types: quantum Fourier transforms, group automorphism gates and quadratic phase gates. In this work, we extend the normalizer formalism [1,2] to infinite dimensions, by allowing normalizer gates to act on systems of the form \${\textbackslash}mathcal\{H\}\_{\textbackslash}mathbb\{Z\}{\textasciicircum}\{{\textbackslash}otimes a\}\$: each factor \${\textbackslash}mathcal\{H\}\_{\textbackslash}mathbb\{Z\}\$ has a standard basis labeled by \${\textbackslash}textit\{integers\}\$ \${\textbackslash}mathbb\{Z\}\$, and a Fourier basis labeled by \${\textbackslash}textit\{angles\}\$, elements of the circle group \${\textbackslash}mathbb\{T\}\$. Normalizer circuits become hybrid quantum circuits acting both on continuous- and discrete-variable systems. We show that infinite-dimensional normalizer circuits can be efficiently simulated classically with a generalized \${\textbackslash}textit\{stabilizer formalism\}\$ for Hilbert spaces associated with groups of the form \${\textbackslash}mathbb\{Z\}{\textasciicircum}a{\textbackslash}times {\textbackslash}mathbb\{T\}{\textasciicircum}b {\textbackslash}times {\textbackslash}mathbb\{Z\}\_\{d\_1\}{\textbackslash}times...{\textbackslash}times {\textbackslash}mathbb\{Z\}\_\{d\_n\}\$. We develop new techniques to track stabilizer-groups based on normal forms for group automorphisms and quadratic functions. We use our normal forms to reduce the problem of simulating normalizer circuits to that of finding general solutions of systems of mixed real-integer linear equations [3] and exploit this fact to devise a robust simulation algorithm: the latter remains efficient even in pathological cases where stabilizer groups become infinite, uncountable and non-compact. The techniques developed in this paper might find applications in the study of fault-tolerant quantum computation with superconducting qubits [4,5].},
	language = {en-US},
	urldate = {2025-04-14},
	publisher = {arXiv},
	author = {Bermejo-Vega, Juan and Lin, Cedric Yen-Yu and Nest, Maarten Van den},
	month = jan,
	year = {2015},
	note = {arXiv:1409.3208 [quant-ph]},
	annote = {Comment: 54 pages + appendices. The discussion has been extended in this version},
  keywords = {zotero}
}

