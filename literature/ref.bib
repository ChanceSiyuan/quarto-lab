	note = {arXiv:1609.07497 [quant-ph]},
	pages = {022313},
	annote = {Comment: 25 pages, 17 figures; in v2, some content has been moved to an appendix, a few tables have been restructured and the the title has been updated to conform to journal specifications. v3 fixes minor typos in Figs. 1 \& 6},
  keywords = {zotero}
}

