@article{wilsonTrappedArraysAlkaline2022,
	title = {Trapped arrays of alkaline earth {Rydberg} atoms in optical tweezers},
	volume = {128},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/1912.08754},
	doi = {10.1103/PhysRevLett.128.033201},
	abstract = {Neutral atom qubits with Rydberg-mediated interactions are a leading platform for developing large-scale coherent quantum systems. In the majority of experiments to date, the Rydberg states are not trapped by the same potential that confines ground state atoms, resulting in atom loss and constraints on the achievable interaction time. In this work, we demonstrate that the Rydberg states of an alkaline earth atom, ytterbium, can be stably trapped by the same red-detuned optical tweezer that also confines the ground state, by leveraging the polarizability of the Yb\${\textasciicircum}+\$ ion core. Using the previously unobserved {\textbackslash}tripletS series, we demonstrate trapped Rydberg atom lifetimes exceeding \$100{\textbackslash},{\textbackslash}mu\$s, and observe no evidence of auto- or photo-ionization from the trap light for these states. We measure a coherence time of \$T\_2 = 59\$ \${\textbackslash}mu\$s between two Rydberg levels, exceeding the 28 \${\textbackslash}mu\$s lifetime of untrapped Rydberg atoms under the same conditions. These results are promising for extending the interaction time of Rydberg atom arrays for quantum simulation and computing, and are vital to capitalize on the extended Rydberg lifetimes in circular states or cryogenic environments.},
	language = {en},
	number = {3},
	urldate = {2024-02-18},
	journal = {Physical Review Letters},
	author = {Wilson, Jack and Saskin, Samuel and Meng, Yijian and Ma, Shuo and Dilip, Rohit and Burgers, Alex and Thompson, Jeff},
	month = jan,
	year = {2022},
	note = {arXiv:1912.08754 [physics, physics:quant-ph]},
	pages = {033201},
	annote = {Comment: edited references},
  keywords = {zotero}
}

