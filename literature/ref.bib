@article{huangLearningManybodyHamiltonians2023,
	title = {Learning many-body {Hamiltonians} with {Heisenberg}-limited scaling},
	volume = {130},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/2210.03030},
	doi = {10.1103/PhysRevLett.130.200403},
	abstract = {Learning a many-body Hamiltonian from its dynamics is a fundamental problem in physics. In this work, we propose the first algorithm to achieve the Heisenberg limit for learning an interacting \$N\$-qubit local Hamiltonian. After a total evolution time of \${\textbackslash}mathcal\{O\}(ε{\textasciicircum}\{-1\})\$, the proposed algorithm can efficiently estimate any parameter in the \$N\$-qubit Hamiltonian to \$ε\$-error with high probability. The proposed algorithm is robust against state preparation and measurement error, does not require eigenstates or thermal states, and only uses \${\textbackslash}mathrm\{polylog\}(ε{\textasciicircum}\{-1\})\$ experiments. In contrast, the best previous algorithms, such as recent works using gradient-based optimization or polynomial interpolation, require a total evolution time of \${\textbackslash}mathcal\{O\}(ε{\textasciicircum}\{-2\})\$ and \${\textbackslash}mathcal\{O\}(ε{\textasciicircum}\{-2\})\$ experiments. Our algorithm uses ideas from quantum simulation to decouple the unknown \$N\$-qubit Hamiltonian \$H\$ into noninteracting patches, and learns \$H\$ using a quantum-enhanced divide-and-conquer approach. We prove a matching lower bound to establish the asymptotic optimality of our algorithm.},
	number = {20},
	urldate = {2026-06-30},
	journal = {Physical Review Letters},
	author = {Huang, Hsin-Yuan and Tong, Yu and Fang, Di and Su, Yuan},
	month = may,
	year = {2023},
	note = {arXiv:2210.03030 [quant-ph]},
	pages = {200403},
	annote = {Comment: 11 pages, 1 figure + 27-page appendix},
  keywords = {zotero}
}

