@misc{allcockBellSamplingStabilizer2024,
	title = {Beyond {Bell} sampling: stabilizer state learning and quantum pseudorandomness lower bounds on qudits},
	shorttitle = {Beyond {Bell} sampling},
	url = {http://arxiv.org/abs/2405.06357},
	doi = {10.48550/arXiv.2405.06357},
	abstract = {Bell sampling is a simple yet powerful measurement primitive that has recently attracted a lot of attention, and has proven to be a valuable tool in studying stabiliser states. Unfortunately, however, it is known that Bell sampling fails when used on qu{\textbackslash}emph\{d\}its of dimension \$d{\textgreater}2\$. In this paper, we explore and quantify the limitations of Bell sampling on qudits, and propose new quantum algorithms to circumvent the use of Bell sampling in solving two important problems: learning stabiliser states and providing pseudorandomness lower bounds on qudits. More specifically, as our first result, we characterise the output distribution corresponding to Bell sampling on copies of a stabiliser state and show that the output can be uniformly random, and hence reveal no information. As our second result, for \$d=p\$ prime we devise a quantum algorithm to identify an unknown stabiliser state in \$({\textbackslash}mathbb\{C\}{\textasciicircum}p){\textasciicircum}\{{\textbackslash}otimes n\}\$ that uses \$O(n)\$ copies of the input state and runs in time \$O(n{\textasciicircum}4)\$. As our third result, we provide a quantum algorithm that efficiently distinguishes a Haar-random state from a state with non-negligible stabiliser fidelity. As a corollary, any Clifford circuit on qudits of dimension \$d\$ using \$O({\textbackslash}log\{n\}/{\textbackslash}log\{d\})\$ auxiliary non-Clifford single-qudit gates cannot prepare computationally pseudorandom quantum states.},
	urldate = {2025-07-17},
	publisher = {arXiv},
	author = {Allcock, Jonathan and Doriguello, Joao F. and Ivanyos, Gábor and Santha, Miklos},
	month = may,
	year = {2024},
	note = {arXiv:2405.06357 [quant-ph]},
	annote = {Comment: 35 pages},
  keywords = {zotero}
}

@misc{allcockReconqueringBellSampling2025,
	title = {Reconquering {Bell} sampling on qudits: stabilizer learning and testing, quantum pseudorandomness bounds, and more},
	shorttitle = {Reconquering {Bell} sampling on qudits},
	url = {http://arxiv.org/abs/2510.06848},
	doi = {10.48550/arXiv.2510.06848},
	abstract = {Bell sampling is a simple yet powerful tool based on measuring two copies of a quantum state in the Bell basis, and has found applications in a plethora of problems related to stabiliser states and measures of magic. However, it was not known how to generalise the procedure from qubits to \$d\$-level systems -- qudits -- for all dimensions \$d {\textgreater} 2\$ in a useful way. Indeed, a prior work of the authors (arXiv'24) showed that the natural extension of Bell sampling to arbitrary dimensions fails to provide meaningful information about the quantum states being measured. In this paper, we overcome the difficulties encountered in previous works and develop a useful generalisation of Bell sampling to qudits of all \$d{\textbackslash}geq 2\$. At the heart of our primitive is a new unitary, based on Lagrange's four-square theorem, that maps four copies of any stabiliser state \${\textbar}{\textbackslash}mathcal\{S\}{\textbackslash}rangle\$ to four copies of its complex conjugate \${\textbar}{\textbackslash}mathcal\{S\}{\textasciicircum}{\textbackslash}ast{\textbackslash}rangle\$ (up to some Pauli operator), which may be of independent interest. We then demonstrate the utility of our new Bell sampling technique by lifting several known results from qubits to qudits for any \$d{\textbackslash}geq 2\$: 1. Learning stabiliser states in \$O(n{\textasciicircum}3)\$ time with \$O(n)\$ samples; 2. Solving the Hidden Stabiliser Group Problem in \${\textbackslash}tilde\{O\}(n{\textasciicircum}3/{\textbackslash}varepsilon)\$ time with \${\textbackslash}tilde\{O\}(n/{\textbackslash}varepsilon)\$ samples; 3. Testing whether \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ has stabiliser size at least \$d{\textasciicircum}t\$ or is \${\textbackslash}varepsilon\$-far from all such states in \${\textbackslash}tilde\{O\}(n{\textasciicircum}3/{\textbackslash}varepsilon)\$ time with \${\textbackslash}tilde\{O\}(n/{\textbackslash}varepsilon)\$ samples; 4. Clifford circuits with at most \$n/2\$ single-qudit non-Clifford gates cannot prepare pseudorandom states; 5. Testing whether \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ has stabiliser fidelity at least \$1-{\textbackslash}varepsilon\_1\$ or at most \$1-{\textbackslash}varepsilon\_2\$ with \$O(d{\textasciicircum}2/{\textbackslash}varepsilon\_2)\$ samples if \${\textbackslash}varepsilon\_1 = 0\$ or \$O(d{\textasciicircum}2/{\textbackslash}varepsilon\_2{\textasciicircum}2)\$ samples if \${\textbackslash}varepsilon\_1 = O(d{\textasciicircum}\{-2\})\$.},
	urldate = {2025-10-12},
	publisher = {arXiv},
	author = {Allcock, Jonathan and Doriguello, Joao F. and Ivanyos, Gábor and Santha, Miklos},
	month = oct,
	year = {2025},
	note = {arXiv:2510.06848 [quant-ph]},
	annote = {Comment: 51 pages, 1 figure. Comments are welcome},
  keywords = {zotero}
}

@article{almheiriBulkLocalityQuantum2015,
	title = {Bulk locality and quantum error correction in {AdS}/{CFT}},
	volume = {2015},
	issn = {1029-8479},
	url = {http://link.springer.com/10.1007/JHEP04(2015)163},
	doi = {10.1007/JHEP04(2015)163},
	abstract = {We point out a connection between the emergence of bulk locality in AdS/CFT and the theory of quantum error correction. Bulk notions such as Bogoliubov transformations, location in the radial direction, and the holographic entropy bound all have natural CFT interpretations in the language of quantum error correction. We also show that the question of whether bulk operator reconstruction works only in the causal wedge or all the way to the extremal surface is related to the question of whether or not the quantum error correcting code realized by AdS/CFT is also a “quantum secret sharing scheme”, and suggest a tensor network calculation that may settle the issue. Interestingly, the version of quantum error correction which is best suited to our analysis is the somewhat nonstandard “operator algebra quantum error correction” of Beny, Kempf, and Kribs. Our proposal gives a precise formulation of the idea of “subregion-subregion” duality in AdS/CFT, and clariﬁes the limits of its validity.},
	language = {en},
	number = {4},
	urldate = {2026-06-21},
	journal = {Journal of High Energy Physics},
	author = {Almheiri, Ahmed and Dong, Xi and Harlow, Daniel},
	month = apr,
	year = {2015},
	pages = {163},
  keywords = {zotero}
}

