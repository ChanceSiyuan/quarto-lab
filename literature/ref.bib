@inproceedings{wattsExponentialSeparationShallow2019,
	title = {Exponential separation between shallow quantum circuits and unbounded fan-in shallow classical circuits},
	url = {http://arxiv.org/abs/1906.08890},
	doi = {10.1145/3313276.3316404},
	abstract = {Recently, Bravyi, Gosset, and König (Science, 2018) exhibited a search problem called the 2D Hidden Linear Function (2D HLF) problem that can be solved exactly by a constant-depth quantum circuit using bounded fan-in gates (or QNC{\textasciicircum}0 circuits), but cannot be solved by any constant-depth classical circuit using bounded fan-in AND, OR, and NOT gates (or NC{\textasciicircum}0 circuits). In other words, they exhibited a search problem in QNC{\textasciicircum}0 that is not in NC{\textasciicircum}0. We strengthen their result by proving that the 2D HLF problem is not contained in AC{\textasciicircum}0, the class of classical, polynomial-size, constant-depth circuits over the gate set of unbounded fan-in AND and OR gates, and NOT gates. We also supplement this worst-case lower bound with an average-case result: There exists a simple distribution under which any AC{\textasciicircum}0 circuit (even of nearly exponential size) has exponentially small correlation with the 2D HLF problem. Our results are shown by constructing a new problem in QNC{\textasciicircum}0, which we call the Relaxed Parity Halving Problem, which is easier to work with. We prove our AC{\textasciicircum}0 lower bounds for this problem, and then show that it reduces to the 2D HLF problem. As a step towards even stronger lower bounds, we present a search problem that we call the Parity Bending Problem, which is in QNC{\textasciicircum}0/qpoly (QNC{\textasciicircum}0 circuits that are allowed to start with a quantum state of their choice that is independent of the input), but is not even in AC{\textasciicircum}0[2] (the class AC{\textasciicircum}0 with unbounded fan-in XOR gates). All the quantum circuits in our paper are simple, and the main difficulty lies in proving the classical lower bounds. For this we employ a host of techniques, including a refinement of Håstad's switching lemmas for multi-output circuits that may be of independent interest, the Razborov-Smolensky AC{\textasciicircum}0[2] lower bound, Vazirani's XOR lemma, and lower bounds for non-local games.},
	urldate = {2026-07-16},
	booktitle = {Proceedings of the 51st {Annual} {ACM} {SIGACT} {Symposium} on {Theory} of {Computing}},
	author = {Watts, Adam Bene and Kothari, Robin and Schaeffer, Luke and Tal, Avishay},
	month = jun,
	year = {2019},
	note = {arXiv:1906.08890 [quant-ph]},
	pages = {515--526},
  keywords = {zotero}
}

@misc{wattsUnconditionalQuantumAdvantage2024,
	title = {Unconditional {Quantum} {Advantage} for {Sampling} with {Shallow} {Circuits}},
	url = {http://arxiv.org/abs/2301.00995},
	doi = {10.48550/arXiv.2301.00995},
	abstract = {Recent work by Bravyi, Gosset, and Koenig showed that there exists a search problem that a constant-depth quantum circuit can solve, but that any constant-depth classical circuit with bounded fan-in cannot. They also pose the question: Can we achieve a similar proof of separation for an input-independent sampling task? In this paper, we show that the answer to this question is yes when the number of random input bits given to the classical circuit is bounded. We introduce a distribution \$D\_\{n\}\$ over \${\textbackslash}\{0,1{\textbackslash}\}{\textasciicircum}n\$ and construct a constant-depth uniform quantum circuit family \${\textbackslash}\{C\_n{\textbackslash}\}\_n\$ such that \$C\_n\$ samples from a distribution close to \$D\_\{n\}\$ in total variation distance. For any \$δ{\textless} 1\$ we also prove, unconditionally, that any classical circuit with bounded fan-in gates that takes as input \$kn + n{\textasciicircum}δ\$ i.i.d. Bernouli random variables with entropy \$1/k\$ and produces output close to \$D\_\{n\}\$ in total variation distance has depth \$Ω({\textbackslash}log {\textbackslash}log n)\$. This gives an unconditional proof that constant-depth quantum circuits can sample from distributions that can't be reproduced by constant-depth bounded fan-in classical circuits, even up to additive error. We also show a similar separation between constant-depth quantum circuits with advice and classical circuits with bounded fan-in and fan-out, but access to an unbounded number of i.i.d random inputs. The distribution \$D\_n\$ and classical circuit lower bounds are inspired by work of Viola, in which he shows a different (but related) distribution cannot be sampled from approximately by constant-depth bounded fan-in classical circuits.},
	urldate = {2026-07-20},
	publisher = {arXiv},
	author = {Watts, Adam Bene and Parham, Natalie},
	month = mar,
	year = {2024},
	note = {arXiv:2301.00995 [quant-ph]},
	annote = {Comment: 54 pages, 12 figures. The new version improves the result with proofs in the appendices, and includes a new proof overview in the introduction},
  keywords = {zotero}
}

