@misc{shinResourceefficientAlgorithmEstimating2025,
	title = {Resource-efficient algorithm for estimating the trace of quantum state powers},
	url = {http://arxiv.org/abs/2408.00314},
	doi = {10.48550/arXiv.2408.00314},
	abstract = {Estimating the trace of quantum state powers, \${\textbackslash}text\{Tr\}({\textbackslash}rho{\textasciicircum}k)\$, for \$k\$ identical quantum states is a fundamental task with numerous applications in quantum information processing, including nonlinear function estimation of quantum states and entanglement detection. On near-term quantum devices, reducing the required quantum circuit depth, the number of multi-qubit quantum operations, and the copies of the quantum state needed for such computations is crucial. In this work, inspired by the Newton-Girard method, we significantly improve upon existing results by introducing an algorithm that requires only \${\textbackslash}mathcal\{O\}({\textbackslash}widetilde\{r\})\$ qubits and \${\textbackslash}mathcal\{O\}({\textbackslash}widetilde\{r\})\$ multi-qubit gates, where \${\textbackslash}widetilde\{r\} = {\textbackslash}min{\textbackslash}left{\textbackslash}\{{\textbackslash}text\{rank\}({\textbackslash}rho), {\textbackslash}left{\textbackslash}lceil{\textbackslash}ln{\textbackslash}left(\{2k\}/\{{\textbackslash}epsilon\}{\textbackslash}right){\textbackslash}right{\textbackslash}rceil{\textbackslash}right{\textbackslash}\}\$. This approach is efficient, as it employs the \${\textbackslash}tilde\{r\}\$-entangled copy measurement instead of the conventional \$k\$-entangled copy measurement, while asymptotically preserving the known sample complexity upper bound. Furthermore, we prove that estimating \${\textbackslash}\{{\textbackslash}text\{Tr\}({\textbackslash}rho{\textasciicircum}i){\textbackslash}\}\_\{i=1\}{\textasciicircum}\{{\textbackslash}tilde\{r\}\}\$ is sufficient to approximate \${\textbackslash}text\{Tr\}({\textbackslash}rho{\textasciicircum}k)\$ even for large integers \$k {\textgreater} {\textbackslash}widetilde\{r\}\$. This leads to a rank-dependent complexity for solving the problem, providing an efficient algorithm for low-rank quantum states while also improving existing methods when the rank is unknown or when the state is not low-rank. Building upon these advantages, we extend our algorithm to the estimation of \${\textbackslash}text\{Tr\}(M{\textbackslash}rho{\textasciicircum}k)\$ for arbitrary observables and \${\textbackslash}text\{Tr\}({\textbackslash}rho{\textasciicircum}k {\textbackslash}sigma{\textasciicircum}l)\$ for multiple quantum states.},
	urldate = {2025-08-16},
	publisher = {arXiv},
	author = {Shin, Myeongjin and Lee, Junseo and Lee, Seungwoo and Jeong, Kabgyun},
	month = aug,
	year = {2025},
	note = {arXiv:2408.00314 [quant-ph]},
	annote = {Comment: 45 pages, 9 figures, 4 tables, The first two authors (MS, JL) contributed equally to this work},
  keywords = {zotero}
}

