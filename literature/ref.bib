	url = {http://arxiv.org/abs/2410.22220},
	doi = {10.48550/arXiv.2410.22220},
	abstract = {We show an improved inverse theorem for the Gowers-\$3\$ norm of \$n\$-qubit quantum states \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ which states that: for every \${\textbackslash}gamma{\textbackslash}geq 0\$, if the \${\textbackslash}textsf\{Gowers\}({\textbar}{\textbackslash}psi {\textbackslash}rangle,3){\textasciicircum}8 {\textbackslash}geq {\textbackslash}gamma\$ then the stabilizer fidelity of \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ is at least \${\textbackslash}gamma{\textasciicircum}C\$ for some constant \$C{\textgreater}1\$. This implies a constant-sample polynomial-time tolerant testing algorithm for stabilizer states which accepts if an unknown state is \${\textbackslash}varepsilon\_1\$-close to a stabilizer state in fidelity and rejects when \${\textbar}{\textbackslash}psi{\textbackslash}rangle\$ is \${\textbackslash}varepsilon\_2 {\textbackslash}leq {\textbackslash}varepsilon\_1{\textasciicircum}C\$-far from all stabilizer states, promised one of them is the case.},
