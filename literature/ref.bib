@misc{purcellChaitinPhaseTransition2024,
	title = {Chaitin {Phase} {Transition}},
	url = {http://arxiv.org/abs/2410.02600},
	doi = {10.48550/arXiv.2410.02600},
	abstract = {We construct a family of Hamiltonians whose phase diagram is guaranteed to have a single phase transition, yet the location of this phase transition is uncomputable. The Hamiltonians \$H({\textbackslash}phi)\$ describe qudits on a two-dimensional square lattice with translationally invariant, nearest-neighbour interactions tuned by a continuous parameter \${\textbackslash}phi{\textbackslash}in(0,1]\$. For all \${\textbackslash}phi{\textbackslash}in(0,1]\$, \$H({\textbackslash}phi)\$ is in one of two phases, one a gapless phase, the other a gapped phase. The phase transition occurs when \${\textbackslash}phi\$ equals the Chaitin's constant \${\textbackslash}Omega\$, a well-defined real number that encodes the Halting problem, and hence is uncomputable for Turing machines and undecidable for any consistent recursive axiomatization of mathematics. Our result implies that no general algorithm exists to determine the phase diagrams even under the promise that the phase diagram is exceedingly simple, and illustrates how uncomputable numbers may manifest in physical systems.},
	urldate = {2025-04-09},
	publisher = {arXiv},
	author = {Purcell, James and Li, Zhi and Cubitt, Toby},
	month = oct,
	year = {2024},
	note = {arXiv:2410.02600 [quant-ph]},
  keywords = {zotero}
}

