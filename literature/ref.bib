@misc{goldsteinDenseSubgraphProblem2010,
	title = {The {Dense} k {Subgraph} problem},
	url = {http://arxiv.org/abs/0912.5327},
	doi = {10.48550/arXiv.0912.5327},
	abstract = {Given a graph G = (V,E) and a parameter k, we consider the problem of finding a subset U in V of size k that maximizes the number of induced edges (DkS). We improve upon the previously best known approximation ratio for DkS, a ratio that has not seen any progress during the last decade. Specifically, we improve the approximation ratio from n{\textasciicircum}\{0.32258\} to n{\textasciicircum}\{0.3159\}. The improved ratio is obtained by studying a variant to the DkS problem in which one considers the problem of finding a subset U in V of size at most k that maximizes the number of induced edges. Finally, we study the DkS variant in which one considers the problem of finding a subset U in V of size at least k that maximizes the number of induced edges.},
