@misc{gibneyNearOptimalQuantumAlgorithms2023,
	title = {Near-{Optimal} {Quantum} {Algorithms} for {Bounded} {Edit} {Distance} and {Lempel}-{Ziv} {Factorization}},
	url = {http://arxiv.org/abs/2311.01793},
	doi = {10.48550/arXiv.2311.01793},
	abstract = {Classically, the edit distance of two length-\$n\$ strings can be computed in \$O(n{\textasciicircum}2)\$ time, whereas an \$O(n{\textasciicircum}\{2-ε\})\$-time procedure would falsify the Orthogonal Vectors Hypothesis. If the edit distance does not exceed \$k\$, the running time can be improved to \$O(n+k{\textasciicircum}2)\$, which is near-optimal (conditioned on OVH) as a function of \$n\$ and \$k\$. Our first main contribution is a quantum \${\textbackslash}tilde\{O\}({\textbackslash}sqrt\{nk\}+k{\textasciicircum}2)\$-time algorithm that uses \${\textbackslash}tilde\{O\}({\textbackslash}sqrt\{nk\})\$ queries, where \${\textbackslash}tilde\{O\}({\textbackslash}cdot)\$ hides polylogarithmic factors. This query complexity is unconditionally optimal, and any significant improvement in the time complexity would resolve a long-standing open question of whether edit distance admits an \$O(n{\textasciicircum}\{2-ε\})\$-time quantum algorithm. Our divide-and-conquer quantum algorithm reduces the edit distance problem to a case where the strings have small Lempel-Ziv factorizations. Then, it combines a quantum LZ compression algorithm with a classical edit-distance subroutine for compressed strings. The LZ factorization problem can be classically solved in \$O(n)\$ time, which is unconditionally optimal in the quantum setting. We can, however, hope for a quantum speedup if we parameterize the complexity in terms of the factorization size \$z\$. Already a generic oracle identification algorithm yields the optimal query complexity of \${\textbackslash}tilde\{O\}({\textbackslash}sqrt\{nz\})\$ at the price of exponential running time. Our second main contribution is a quantum algorithm that achieves the optimal time complexity of \${\textbackslash}tilde\{O\}({\textbackslash}sqrt\{nz\})\$. The key tool is a novel LZ-like factorization of size \$O(z{\textbackslash}log{\textasciicircum}2n)\$ whose subsequent factors can be efficiently computed through a combination of classical and quantum techniques. We can then obtain the string's run-length encoded Burrows-Wheeler Transform (BWT), construct the \$r\$-index, and solve many fundamental string processing problems in time \${\textbackslash}tilde\{O\}({\textbackslash}sqrt\{nz\})\$.},
	urldate = {2026-04-20},
	publisher = {arXiv},
	author = {Gibney, Daniel and Jin, Ce and Kociumaka, Tomasz and Thankachan, Sharma V.},
	month = nov,
	year = {2023},
	note = {arXiv:2311.01793 [cs]},
	annote = {Comment: Accepted to SODA 2024. arXiv admin note: substantial text overlap with arXiv:2302.07235},
  keywords = {zotero}
}

