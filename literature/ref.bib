@article{keylEstimatingSpectrumDensity2001,
	title = {Estimating the spectrum of a density operator},
	volume = {64},
	issn = {1050-2947, 1094-1622},
	url = {http://arxiv.org/abs/quant-ph/0102027},
	doi = {10.1103/PhysRevA.64.052311},
	abstract = {Given N quantum systems prepared according to the same density operator {\textbackslash}rho, we propose a measurement on the N-fold system which approximately yields the spectrum of {\textbackslash}rho. The projections of the proposed observable decompose the Hilbert space according to the irreducible representations of the permutations on N points, and are labeled by Young frames, whose relative row lengths estimate the eigenvalues of {\textbackslash}rho in decreasing order. We show convergence of these estimates in the limit N{\textbackslash}to{\textbackslash}infty, and that the probability for errors decreases exponentially with a rate we compute explicitly.},
