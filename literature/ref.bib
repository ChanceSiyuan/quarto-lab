@article{flammiaPauliErrorEstimation2021,
	title = {Pauli error estimation via {Population} {Recovery}},
	volume = {5},
	issn = {2521-327X},
	url = {http://arxiv.org/abs/2105.02885},
	doi = {10.22331/q-2021-09-23-549},
	abstract = {Motivated by estimation of quantum noise models, we study the problem of learning a Pauli channel, or more generally the Pauli error rates of an arbitrary channel. By employing a novel reduction to the "Population Recovery" problem, we give an extremely simple algorithm that learns the Pauli error rates of an \$n\$-qubit channel to precision \${\textbackslash}epsilon\$ in \${\textbackslash}ell\_{\textbackslash}infty\$ using just \$O(1/{\textbackslash}epsilon{\textasciicircum}2) {\textbackslash}log(n/{\textbackslash}epsilon)\$ applications of the channel. This is optimal up to the logarithmic factors. Our algorithm uses only unentangled state preparation and measurements, and the post-measurement classical runtime is just an \$O(1/{\textbackslash}epsilon)\$ factor larger than the measurement data size. It is also impervious to a limited model of measurement noise where heralded measurement failures occur independently with probability \${\textbackslash}le 1/4\$. We then consider the case where the noise channel is close to the identity, meaning that the no-error outcome occurs with probability \$1-{\textbackslash}eta\$. In the regime of small \${\textbackslash}eta\$ we extend our algorithm to achieve multiplicative precision \$1 {\textbackslash}pm {\textbackslash}epsilon\$ (i.e., additive precision \${\textbackslash}epsilon {\textbackslash}eta\$) using just \$O{\textbackslash}bigl({\textbackslash}frac\{1\}\{{\textbackslash}epsilon{\textasciicircum}2 {\textbackslash}eta\}{\textbackslash}bigr) {\textbackslash}log(n/{\textbackslash}epsilon)\$ applications of the channel.},
	language = {en},
	urldate = {2024-04-07},
	journal = {Quantum},
	author = {Flammia, Steven T. and O'Donnell, Ryan},
	month = sep,
	year = {2021},
	note = {arXiv:2105.02885 [quant-ph]},
	pages = {549},
	annote = {Comment: 19 pages. v1: Preliminary version in TQC 2021. v2: Journal version with some additional references and background on Pauli channel estimation. Source code available at https://github.com/sflammia/PauliPopRec},
  keywords = {zotero}
}

@misc{fletcherChannelAdaptedQuantumError2007,
	title = {Channel-{Adapted} {Quantum} {Error} {Correction} for the {Amplitude} {Damping} {Channel}},
	url = {http://arxiv.org/abs/0710.1052},
	doi = {10.48550/arXiv.0710.1052},
	abstract = {We consider error correction procedures designed specifically for the amplitude damping channel. We analyze amplitude damping errors in the stabilizer formalism. This analysis allows a generalization of the [4,1] `approximate' amplitude damping code of quant-ph/9704002. We present this generalization as a class of [2(M+1),M] codes and present quantum circuits for encoding and recovery operations. We also present a [7,3] amplitude damping code based on the classical Hamming code. All of these are stabilizer codes whose encoding and recovery operations can be completely described with Clifford group operations. Finally, we describe optimization options in which recovery operations may be further adapted according to the damping probability gamma.},
