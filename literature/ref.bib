@article{grewalLowStabilizerComplexityQuantumStates2023,
	title = {Low-{Stabilizer}-{Complexity} {Quantum} {States} {Are} {Not} {Pseudorandom}},
	volume = {251},
	copyright = {Creative Commons Attribution 4.0 International license, info:eu-repo/semantics/openAccess},
