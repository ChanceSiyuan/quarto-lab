  keywords = {zotero}
}

@book{thompsonExplicitVectorAlgorithm2022,
	title = {An explicit vector algorithm for high-girth {MaxCut}},
	url = {http://arxiv.org/abs/2108.12477},
	doi = {10.1137/1.9781611977066.17},
	abstract = {We give an approximation algorithm for MaxCut and provide guarantees on the average fraction of edges cut on \$d\$-regular graphs of girth \${\textbackslash}geq 2k\$. For every \$d {\textbackslash}geq 3\$ and \$k {\textbackslash}geq 4\$, our approximation guarantees are better than those of all other classical and quantum algorithms known to the authors. Our algorithm constructs an explicit vector solution to the standard semidefinite relaxation of MaxCut and applies hyperplane rounding. It may be viewed as a simplification of the previously best known technique, which approximates Gaussian wave processes on the infinite \$d\$-regular tree.},
