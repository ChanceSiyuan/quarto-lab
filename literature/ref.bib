@misc{gongLowlatencyIterativeDecoding2024,
	title = {Toward {Low}-latency {Iterative} {Decoding} of {QLDPC} {Codes} {Under} {Circuit}-{Level} {Noise}},
	url = {http://arxiv.org/abs/2403.18901},
	abstract = {We introduce a sliding window decoder based on belief propagation (BP) with guided decimation for the purposes of decoding quantum low-density parity-check codes in the presence of circuit-level noise. Windowed decoding keeps the decoding complexity reasonable when, as is typically the case, repeated rounds of syndrome extraction are required to decode. Within each window, we employ several rounds of BP with decimation of the variable node that we expect to be the most likely to flip in each round, Furthermore, we employ ensemble decoding to keep both decimation options (guesses) open in a small number of chosen rounds. We term the resulting decoder BP with guided decimation guessing (GDG). Applied to bivariate bicycle codes, GDG achieves a similar logical error rate as BP with an additional OSD post-processing stage (BP+OSD) and combination-sweep of order 10. For a window size of three syndrome cycles, a multi-threaded CPU implementation of GDG achieves a worst-case decoding latency of 3ms per window for the [[144,12,12]] code.},
	urldate = {2024-10-17},
	publisher = {arXiv},
	author = {Gong, Anqi and Cammerer, Sebastian and Renes, Joseph M.},
	month = mar,
	year = {2024},
	note = {arXiv:2403.18901 [quant-ph]},
	annote = {Comment: 8+4 pages, 7 figures. The source code for the simulations in this work is available online at http://github.com/gongaa/SlidingWindowDecoder},
  keywords = {zotero}
}

@misc{gongSampleComplexityPurity2024,
	title = {On the sample complexity of purity and inner product estimation},
	url = {http://arxiv.org/abs/2410.12712},
	doi = {10.48550/arXiv.2410.12712},
	abstract = {We study the sample complexity of the prototypical tasks quantum purity estimation and quantum inner product estimation. In purity estimation, we are to estimate \$tr({\textbackslash}rho{\textasciicircum}2)\$ of an unknown quantum state \${\textbackslash}rho\$ to additive error \${\textbackslash}epsilon\$. Meanwhile, for quantum inner product estimation, Alice and Bob are to estimate \$tr({\textbackslash}rho{\textbackslash}sigma)\$ to additive error \${\textbackslash}epsilon\$ given copies of unknown quantum state \${\textbackslash}rho\$ and \${\textbackslash}sigma\$ using classical communication and restricted quantum communication. In this paper, we show a strong connection between the sample complexity of purity estimation with bounded quantum memory and inner product estimation with bounded quantum communication and unentangled measurements. We propose a protocol that solves quantum inner product estimation with \$k\$-qubit one-way quantum communication and unentangled local measurements using \$O(median{\textbackslash}\{1/{\textbackslash}epsilon{\textasciicircum}2,2{\textasciicircum}\{n/2\}/{\textbackslash}epsilon,2{\textasciicircum}\{n-k\}/{\textbackslash}epsilon{\textasciicircum}2{\textbackslash}\})\$ copies of \${\textbackslash}rho\$ and \${\textbackslash}sigma\$. Our protocol can be modified to estimate the purity of an unknown quantum state \${\textbackslash}rho\$ using \$k\$-qubit quantum memory with the same complexity. We prove that arbitrary protocols with \$k\$-qubit quantum memory that estimate purity to error \${\textbackslash}epsilon\$ require \${\textbackslash}Omega(median{\textbackslash}\{1/{\textbackslash}epsilon{\textasciicircum}2,2{\textasciicircum}\{n/2\}/{\textbackslash}sqrt\{{\textbackslash}epsilon\},2{\textasciicircum}\{n-k\}/{\textbackslash}epsilon{\textasciicircum}2{\textbackslash}\})\$ copies of \${\textbackslash}rho\$. This indicates the same lower bound for quantum inner product estimation with one-way \$k\$-qubit quantum communication and classical communication, and unentangled local measurements. For purity estimation, we further improve the lower bound to \${\textbackslash}Omega({\textbackslash}max{\textbackslash}\{1/{\textbackslash}epsilon{\textasciicircum}2,2{\textasciicircum}\{n/2\}/{\textbackslash}epsilon{\textbackslash}\})\$ for any protocols using an identical single-copy projection-valued measurement. Additionally, we investigate a decisional variant of quantum distributed inner product estimation without quantum communication for mixed state and provide a lower bound on the sample complexity.},
	urldate = {2025-07-17},
	publisher = {arXiv},
	author = {Gong, Weiyuan and Haferkamp, Jonas and Ye, Qi and Zhang, Zhihan},
	month = oct,
	year = {2024},
	note = {arXiv:2410.12712 [quant-ph]},
	annote = {Comment: 33 pages, 1 figure},
  keywords = {zotero}
}

