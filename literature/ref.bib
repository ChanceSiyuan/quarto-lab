@misc{vandaeleQuantumBinaryField2025,
	title = {Quantum binary field multiplication with subquadratic {Toffoli} gate count and low space-time cost},
	url = {http://arxiv.org/abs/2501.16136},
	doi = {10.48550/arXiv.2501.16136},
	abstract = {Multiplication over binary fields is a crucial operation in quantum algorithms designed to solve the discrete logarithm problem for elliptic curve defined over \$GF(2{\textasciicircum}n)\$. In this paper, we present an algorithm for constructing quantum circuits that perform multiplication over \$GF(2{\textasciicircum}n)\$ with \${\textbackslash}mathcal\{O\}(n{\textasciicircum}\{{\textbackslash}log\_2(3)\})\$ Toffoli gates. We propose a variant of our construction that achieves linear depth by using \${\textbackslash}mathcal\{O\}(n{\textbackslash}log\_2(n))\$ ancillary qubits. This approach provides the best known space-time trade-off for binary field multiplication with a subquadratic number of Toffoli gates. Additionally, we demonstrate that for some particular families of primitive polynomials, such as trinomials, the multiplication can be done in logarithmic depth and with \${\textbackslash}mathcal\{O\}(n{\textasciicircum}\{{\textbackslash}log\_2(3)\})\$ gates.},
