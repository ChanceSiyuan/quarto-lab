@misc{pelecanosBeatingFullState2025,
	title = {Beating full state tomography for unentangled spectrum estimation},
	url = {http://arxiv.org/abs/2504.02785},
	doi = {10.48550/arXiv.2504.02785},
	abstract = {How many copies of a mixed state \${\textbackslash}rho {\textbackslash}in {\textbackslash}mathbb\{C\}{\textasciicircum}\{d {\textbackslash}times d\}\$ are needed to learn its spectrum? To date, the best known algorithms for spectrum estimation require as many copies as full state tomography, suggesting the possibility that learning a state's spectrum might be as difficult as learning the entire state. We show that this is not the case in the setting of unentangled measurements, by giving a spectrum estimation algorithm that uses \$n = O(d{\textasciicircum}3{\textbackslash}cdot ({\textbackslash}log{\textbackslash}log(d) / {\textbackslash}log(d)){\textasciicircum}4 )\$ copies of \${\textbackslash}rho\$, which is asymptotically fewer than the \$n = {\textbackslash}Omega(d{\textasciicircum}3)\$ copies necessary for full state tomography. Our algorithm is inspired by the technique of local moment matching from classical statistics, and shows how it can be applied in the quantum setting. As an important subroutine in our spectrum estimation algorithm, we give an estimator of the \$k\$-th moment \${\textbackslash}operatorname\{tr\}({\textbackslash}rho{\textasciicircum}k)\$ which performs unentangled measurements and uses \$O(d{\textasciicircum}\{3-2/k\})\$ copies of \${\textbackslash}rho\$ in order to achieve a constant multiplicative error. This directly translates to an additive-error estimator of quantum Renyi entropy of order \$k\$ with the same number of copies. Finally, we present numerical evidence that the sample complexity of spectrum estimation can only improve over full state tomography by a sub-polynomial factor. Specifically, for spectrum learning with fully entangled measurements, we run simulations which suggest a lower bound of \${\textbackslash}Omega(d{\textasciicircum}\{2 - {\textbackslash}gamma\})\$ copies for any constant \${\textbackslash}gamma {\textgreater} 0\$. From this, we conclude the current best lower bound of \${\textbackslash}Omega(d)\$ is likely not tight.},
	urldate = {2025-08-19},
	publisher = {arXiv},
	author = {Pelecanos, Angelos and Tan, Xinyu and Tang, Ewin and Wright, John},
	month = apr,
	year = {2025},
	note = {arXiv:2504.02785 [quant-ph]},
	annote = {Comment: 53 pages, 3 figures},
  keywords = {zotero}
}

@article{pelegLowerBoundsStabilizer2022,
	title = {Lower {Bounds} on {Stabilizer} {Rank}},
	volume = {6},
	issn = {2521-327X},
	url = {http://arxiv.org/abs/2106.03214},
	doi = {10.22331/q-2022-02-15-652},
	abstract = {The stabilizer rank of a quantum state \${\textbackslash}psi\$ is the minimal \$r\$ such that \${\textbackslash}left{\textbar} {\textbackslash}psi {\textbackslash}right {\textbackslash}rangle = {\textbackslash}sum\_\{j=1\}{\textasciicircum}r c\_j {\textbackslash}left{\textbar}{\textbackslash}varphi\_j {\textbackslash}right{\textbackslash}rangle\$ for \$c\_j {\textbackslash}in {\textbackslash}mathbb\{C\}\$ and stabilizer states \${\textbackslash}varphi\_j\$. The running time of several classical simulation methods for quantum circuits is determined by the stabilizer rank of the \$n\$-th tensor power of single-qubit magic states. We prove a lower bound of \${\textbackslash}Omega(n)\$ on the stabilizer rank of such states, improving a previous lower bound of \${\textbackslash}Omega({\textbackslash}sqrt\{n\})\$ of Bravyi, Smith and Smolin (arXiv:1506.01396). Further, we prove that for a sufficiently small constant \${\textbackslash}delta\$, the stabilizer rank of any state which is \${\textbackslash}delta\$-close to those states is \${\textbackslash}Omega({\textbackslash}sqrt\{n\}/{\textbackslash}log n)\$. This is the first non-trivial lower bound for approximate stabilizer rank. Our techniques rely on the representation of stabilizer states as quadratic functions over affine subspaces of \${\textbackslash}mathbb\{F\}\_2{\textasciicircum}n\$, and we use tools from analysis of boolean functions and complexity theory. The proof of the first result involves a careful analysis of directional derivatives of quadratic polynomials, whereas the proof of the second result uses Razborov-Smolensky low degree polynomial approximations and correlation bounds against the majority function.},
	language = {en},
	urldate = {2024-07-15},
	journal = {Quantum},
	author = {Peleg, Shir and Shpilka, Amir and Volk, Ben Lee},
	month = feb,
	year = {2022},
	note = {arXiv:2106.03214 [quant-ph]},
	pages = {652},
  keywords = {zotero}
}

