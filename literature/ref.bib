@misc{chenImprovedSampleUpper2025,
	title = {Improved {Sample} {Upper} and {Lower} {Bounds} for {Trace} {Estimation} of {Quantum} {State} {Powers}},
	url = {http://arxiv.org/abs/2505.09563},
	doi = {10.48550/arXiv.2505.09563},
	abstract = {As often emerges in various basic quantum properties such as entropy, the trace of quantum state powers \${\textbackslash}operatorname\{tr\}({\textbackslash}rho{\textasciicircum}q)\$ has attracted a lot of attention. The recent work of Liu and Wang (SODA 2025) showed that \${\textbackslash}operatorname\{tr\}({\textbackslash}rho{\textasciicircum}q)\$ can be estimated to within additive error \${\textbackslash}varepsilon\$ with a dimension-independent sample complexity of \${\textbackslash}widetilde O(1/{\textbackslash}varepsilon{\textasciicircum}\{3+{\textbackslash}frac\{2\}\{q-1\}\})\$ for any constant \$q {\textgreater} 1\$, where only an \${\textbackslash}Omega(1/{\textbackslash}varepsilon)\$ lower bound was given. In this paper, we significantly improve the sample complexity of estimating \${\textbackslash}operatorname\{tr\}({\textbackslash}rho{\textasciicircum}q)\$ in both the upper and lower bounds. In particular: - For \$q {\textgreater} 2\$, we settle the sample complexity with matching upper and lower bounds \${\textbackslash}widetilde {\textbackslash}Theta(1/{\textbackslash}varepsilon{\textasciicircum}2)\$. - For \$1 {\textless} q {\textless} 2\$, we provide an upper bound \${\textbackslash}widetilde O(1/{\textbackslash}varepsilon{\textasciicircum}\{{\textbackslash}frac\{2\}\{q-1\}\})\$, with a lower bound \${\textbackslash}Omega(1/{\textbackslash}varepsilon{\textasciicircum}\{{\textbackslash}max{\textbackslash}\{{\textbackslash}frac\{1\}\{q-1\}, 2{\textbackslash}\}\})\$ for dimension-independent estimators, implying there is only room for a quadratic improvement. Our upper bounds are obtained by (non-plug-in) quantum estimators based on weak Schur sampling, in sharp contrast to the prior approach based on quantum singular value transformation and samplizer.},
	urldate = {2025-08-14},
	publisher = {arXiv},
	author = {Chen, Kean and Wang, Qisheng},
	month = may,
	year = {2025},
	note = {arXiv:2505.09563 [quant-ph]},
	annote = {Comment: 23 pages, 1 table},
