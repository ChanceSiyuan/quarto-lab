@article{berthusenQuantumDynamicsSimulations2022,
	title = {Quantum dynamics simulations beyond the coherence time on {NISQ} hardware by variational {Trotter} compression},
	volume = {4},
	issn = {2643-1564},
	url = {http://arxiv.org/abs/2112.12654},
	doi = {10.1103/PhysRevResearch.4.023097},
	abstract = {We demonstrate a post-quench dynamics simulation of a Heisenberg model on present-day IBM quantum hardware that extends beyond the coherence time of the device. This is achieved using a hybrid quantum-classical algorithm that propagates a state using Trotter evolution and then performs a classical optimization that effectively compresses the time-evolved state into a variational form. When iterated, this procedure enables simulations to arbitrary times with an error controlled by the compression fidelity and a fixed Trotter step size. We show how to measure the required cost function, the overlap between the time-evolved and variational states, on present-day hardware, making use of several error mitigation methods. In addition to carrying out simulations on real hardware, we investigate the performance and scaling behavior of the algorithm with noiseless and noisy classical simulations. We find the main bottleneck in going to larger system sizes to be the difficulty of carrying out the optimization of the noisy cost function.},
	number = {2},
	urldate = {2026-02-22},
	journal = {Physical Review Research},
	author = {Berthusen, Noah F. and Trevisan, Thaís V. and Iadecola, Thomas and Orth, Peter P.},
	month = may,
	year = {2022},
	note = {arXiv:2112.12654 [quant-ph]},
