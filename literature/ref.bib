@article{labibStabilizerRankHigherorder2022,
	title = {Stabilizer rank and higher-order {Fourier} analysis},
	volume = {6},
	issn = {2521-327X},
	url = {http://arxiv.org/abs/2107.10551},
	doi = {10.22331/q-2022-02-09-645},
	abstract = {We establish a link between stabilizer states, stabilizer rank, and higher-order Fourier analysis -- a still-developing area of mathematics that grew out of Gowers's celebrated Fourier-analytic proof of Szemer{\textbackslash}'edi's theorem {\textbackslash}cite\{gowers1998new\}. We observe that \$n\$-qudit stabilizer states are so-called nonclassical quadratic phase functions (defined on affine subspaces of \${\textbackslash}mathbb\{F\}\_p{\textasciicircum}n\$ where \$p\$ is the dimension of the qudit) which are fundamental objects in higher-order Fourier analysis. This allows us to import tools from this theory to analyze the stabilizer rank of quantum states. Quite recently, in {\textbackslash}cite\{peleg2021lower\} it was shown that the \$n\$-qubit magic state has stabilizer rank \${\textbackslash}Omega(n)\$. Here we show that the qudit analog of the \$n\$-qubit magic state has stabilizer rank \${\textbackslash}Omega(n)\$, generalizing their result to qudits of any prime dimension. Our proof techniques use explicitly tools from higher-order Fourier analysis. We believe this example motivates the further exploration of applications of higher-order Fourier analysis in quantum information theory.},
	language = {en},
	urldate = {2024-07-16},
	journal = {Quantum},
	author = {Labib, Farrokh},
	month = feb,
	year = {2022},
	note = {arXiv:2107.10551 [quant-ph]},
	pages = {645},
	annote = {Comment: 16 pages},
  keywords = {zotero}
}

