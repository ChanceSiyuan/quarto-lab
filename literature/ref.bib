@misc{krivelevichPhaseTransitionSite2015,
	title = {The phase transition in site percolation on pseudo-random graphs},
	url = {http://arxiv.org/abs/1404.5731},
	doi = {10.48550/arXiv.1404.5731},
	abstract = {We establish the existence of the phase transition in site percolation on pseudo-random \$d\$-regular graphs. Let \$G=(V,E)\$ be an \$(n,d,{\textbackslash}lambda)\$-graph, that is, a \$d\$-regular graph on \$n\$ vertices in which all eigenvalues of the adjacency matrix, but the first one, are at most \${\textbackslash}lambda\$ in their absolute values. Form a random subset \$R\$ of \$V\$ by putting every vertex \$v{\textbackslash}in V\$ into \$R\$ independently with probability \$p\$. Then for any small enough constant \${\textbackslash}epsilon{\textgreater}0\$, if \$p={\textbackslash}frac\{1-{\textbackslash}epsilon\}\{d\}\$, then with high probability all connected components of the subgraph of \$G\$ induced by \$R\$ are of size at most logarithmic in \$n\$, while for \$p={\textbackslash}frac\{1+{\textbackslash}epsilon\}\{d\}\$, if the eigenvalue ratio \${\textbackslash}lambda/d\$ is small enough as a function of \${\textbackslash}epsilon\$, then typically \$R\$ spans a connected component of size at least \${\textbackslash}frac\{{\textbackslash}epsilon n\}\{d\}\$ and a path of length proportional to \${\textbackslash}frac\{{\textbackslash}epsilon{\textasciicircum}2n\}\{d\}\$.},
	urldate = {2024-12-07},
	publisher = {arXiv},
	author = {Krivelevich, Michael},
	month = jul,
	year = {2015},
	note = {arXiv:1404.5731 [math]},
	annote = {Comment: arXiv admin note: text overlap with arXiv:1201.6529},
  keywords = {zotero}
}

