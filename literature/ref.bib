@article{haugStabilizerEntropiesNonstabilizerness2023,
	title = {Stabilizer entropies and nonstabilizerness monotones},
	volume = {7},
	issn = {2521-327X},
	url = {http://arxiv.org/abs/2303.10152},
	doi = {10.22331/q-2023-08-28-1092},
	abstract = {We study different aspects of the stabilizer entropies (SEs) and compare them against known nonstabilizerness monotones such as the min-relative entropy and the robustness of magic. First, by means of explicit examples, we show that, for R{\textbackslash}'enyi index \$0{\textbackslash}leq n{\textless}2\$, the SEs are not monotones with respect to stabilizer protocols which include computational-basis measurements, not even when restricting to pure states (while the question remains open for \$n{\textbackslash}geq 2\$). Next, we show that, for any R{\textbackslash}'enyi index, the SEs do not satisfy a strong monotonicity condition with respect to computational-basis measurements. We further study SEs in different classes of many-body states. We compare the SEs with other measures, either proving or providing numerical evidence for inequalities between them. Finally, we discuss exact or efficient tensor-network numerical methods to compute SEs of matrix-product states (MPSs) for large numbers of qubits. In addition to previously developed exact methods to compute the R{\textbackslash}'enyi SEs, we also put forward a scheme based on perfect MPS sampling, allowing us to compute efficiently the von Neumann SE for large bond dimensions.},
	language = {en},
	urldate = {2024-07-29},
	journal = {Quantum},
	author = {Haug, Tobias and Piroli, Lorenzo},
	month = aug,
	year = {2023},
	note = {arXiv:2303.10152 [cond-mat, physics:quant-ph]},
	pages = {1092},
	annote = {Comment: 14 pages, 5 figures},
  keywords = {zotero}
}

@misc{hayakawaComputationalComplexityBerry2025,
	title = {Computational complexity of {Berry} phase estimation in topological phases of matter},
	url = {http://arxiv.org/abs/2509.13423},
	doi = {10.48550/arXiv.2509.13423},
	abstract = {The Berry phase is a fundamental quantity in the classification of topological phases of matter. In this paper, we present a new quantum algorithm and several complexity-theoretical results for the Berry phase estimation (BPE) problems. Our new quantum algorithm achieves BPE in a more general setting than previously known quantum algorithms, with a theoretical guarantee. For the complexity-theoretic results, we consider three cases. First, we prove \${\textbackslash}mathsf\{BQP\}\$-completeness when we are given a guiding state that has a large overlap with the ground state. This result establishes an exponential quantum speedup for estimating the Berry phase. Second, we prove \${\textbackslash}mathsf\{dUQMA\}\$-completeness when we have \${\textbackslash}textit\{a priori\}\$ bound for ground state energy. Here, \${\textbackslash}mathsf\{dUQMA\}\$ is a variant of the unique witness version of \${\textbackslash}mathsf\{QMA\}\$ (i.e., \${\textbackslash}mathsf\{UQMA\}\$), which we introduce in this paper, and this class precisely captures the complexity of BPE without the known guiding state. Remarkably, this problem turned out to be the first natural problem contained in both \${\textbackslash}mathsf\{UQMA\}\$ and \${\textbackslash}mathsf\{co\}\$-\${\textbackslash}mathsf\{UQMA\}\$. Third, we show \${\textbackslash}mathsf\{P\}{\textasciicircum}\{{\textbackslash}mathsf\{dUQMA[log]\}\}\$-hardness and containment in \${\textbackslash}mathsf\{P\}{\textasciicircum}\{{\textbackslash}mathsf\{PGQMA[log]\}\}\$ when we have no additional assumption. These results advance the role of quantum computing in the study of topological phases of matter and provide a pathway for clarifying the connection between topological phases of matter and computational complexity.},
	urldate = {2026-06-11},
	publisher = {arXiv},
	author = {Hayakawa, Ryu and Sakamoto, Kazuki and Kiumi, Chusei},
	month = nov,
	year = {2025},
	note = {arXiv:2509.13423 [quant-ph]},
	annote = {Comment: 30 pages, v2: minor modifications},
  keywords = {zotero}
}

@misc{hayashiGeneralizedQuantumSteins2024,
	title = {Generalized {Quantum} {Stein}'s {Lemma} and {Second} {Law} of {Quantum} {Resource} {Theories}},
	url = {http://arxiv.org/abs/2408.02722},
	abstract = {The second law of thermodynamics is the cornerstone of physics, characterizing the convertibility between thermodynamic states through a single function, entropy. Given the universal applicability of thermodynamics, a fundamental question in quantum information theory is whether an analogous second law can be formulated to characterize the convertibility of resources for quantum information processing by such a single function. In 2008, a promising formulation was proposed, linking resource convertibility to the optimal performance of a variant of the quantum version of hypothesis testing. Central to this formulation was the generalized quantum Stein's lemma, which aimed to characterize this optimal performance by a measure of quantum resources, the regularized relative entropy of resource. If proven valid, the generalized quantum Stein's lemma would lead to the second law for quantum resources, with the regularized relative entropy of resource taking the role of entropy in thermodynamics. However, in 2023, a logical gap was found in the original proof of this lemma, casting doubt on the possibility of such a formulation of the second law. In this work, we address this problem by developing alternative techniques and successfully proving the generalized quantum Stein's lemma. Based on our proof, we reestablish and extend the formulation of quantum resource theories with the second law, applicable to both static and dynamical resources. These results resolve the fundamental problem of bridging the analogy between thermodynamics and quantum information theory.},
	urldate = {2024-09-05},
	publisher = {arXiv},
	author = {Hayashi, Masahito and Yamasaki, Hayata},
	month = aug,
	year = {2024},
	note = {arXiv:2408.02722 [quant-ph]},
	annote = {Comment: 32 pages, 1 figure},
  keywords = {zotero}
}

