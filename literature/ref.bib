@article{zhouSingleGateClifford2020,
	title = {Single {T} gate in a {Clifford} circuit drives transition to universal entanglement spectrum statistics},
	volume = {9},
	issn = {2542-4653},
	url = {http://arxiv.org/abs/1906.01079},
	doi = {10.21468/SciPostPhys.9.6.087},
	abstract = {Cliﬀord circuits are insuﬃcient for universal quantum computation or creating t-designs with t ≥ 4. While the entanglement entropy is not a telltale of this insuﬃciency, the entanglement spectrum of a time evolved random product state is: the entanglement levels are Poisson-distributed for circuits restricted to the Cliﬀord gate-set, while the levels follow Wigner-Dyson statistics when universal gates are used. In this paper we show, using ﬁnite-size scaling analysis of diﬀerent measures of level spacing statistics, that in the thermodynamic limit, inserting a single T (π/8) gate in the middle of a random Cliﬀord circuit is suﬃcient to alter the entanglement spectrum from a Poisson to a Wigner-Dyson distribution.},
	language = {en},
	number = {6},
	urldate = {2025-02-04},
