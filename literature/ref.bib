@misc{badescuLowerBoundsTesting2019,
	title = {Lower bounds for testing complete positivity and quantum separability},
	url = {http://arxiv.org/abs/1905.01542},
	abstract = {In this work we are interested the problem of testing quantum entanglement. More specifically, we study the separability problem in quantum property testing, where one is given \$n\$ copies of an unknown mixed quantum state \${\textbackslash}varrho\$ on \${\textbackslash}mathbb\{C\}{\textasciicircum}d {\textbackslash}otimes {\textbackslash}mathbb\{C\}{\textasciicircum}d\$, and one wants to test whether \${\textbackslash}varrho\$ is separable or \${\textbackslash}epsilon\$-far from all separable states in trace distance. We prove that \$n = {\textbackslash}Omega(d{\textasciicircum}2/{\textbackslash}epsilon{\textasciicircum}2)\$ copies are necessary to test separability, assuming \${\textbackslash}epsilon\$ is not too small, viz.{\textbackslash} \${\textbackslash}epsilon = {\textbackslash}Omega(1/{\textbackslash}sqrt\{d\})\$. We also study completely positive distributions on the grid \$[d] {\textbackslash}times [d]\$, as a classical analogue of separable states. We analogously prove that \${\textbackslash}Omega(d/{\textbackslash}epsilon{\textasciicircum}2)\$ samples from an unknown distribution \$p\$ are necessary to decide whether \$p\$ is completely positive or \${\textbackslash}epsilon\$-far from all completely positive distributions in total variation distance. Towards showing that the true complexity may in fact be higher, we also show that learning an unknown completely positive distribution on \$[d] {\textbackslash}times [d]\$ requires \${\textbackslash}Omega(d{\textasciicircum}2/{\textbackslash}epsilon{\textasciicircum}2)\$ samples.},
	urldate = {2024-08-13},
	publisher = {arXiv},
	author = {Bădescu, Costin and O'Donnell, Ryan},
	month = sep,
	year = {2019},
	note = {arXiv:1905.01542 [quant-ph]},
  keywords = {zotero}
}

@misc{badescuQuantumStateCertification2017,
	title = {Quantum state certification},
	url = {http://arxiv.org/abs/1708.06002},
	abstract = {We consider the problem of quantum state certiﬁcation, where one is given n copies of an unknown d-dimensional quantum mixed state ρ, and one wants to test whether ρ is equal to some known mixed state σ or else is ǫ-far from σ. The goal is to use notably fewer copies than the Ω(d2) needed for full tomography on ρ (i.e., density estimation). We give two robust state certiﬁcation algorithms: one with respect to ﬁdelity using n = O(d/ǫ) copies, and one with respect to trace distance using n = O(d/ǫ2) copies. The latter algorithm also applies when σ is unknown as well. These copy complexities are optimal up to constant factors.},
