@misc{chenStabilizerBootstrappingRecipe2024,
	title = {Stabilizer bootstrapping: {A} recipe for efficient agnostic tomography and magic estimation},
	shorttitle = {Stabilizer bootstrapping},
	url = {http://arxiv.org/abs/2408.06967},
	abstract = {We study the task of agnostic tomography: given copies of an unknown \$n\$-qubit state \${\textbackslash}rho\$ which has fidelity \${\textbackslash}tau\$ with some state in a given class \$C\$, find a state which has fidelity \${\textbackslash}ge {\textbackslash}tau - {\textbackslash}epsilon\$ with \${\textbackslash}rho\$. We give a new framework, stabilizer bootstrapping, for designing computationally efficient protocols for this task, and use this to get new agnostic tomography protocols for the following classes: Stabilizer states: We give a protocol that runs in time \${\textbackslash}mathrm\{poly\}(n,1/{\textbackslash}epsilon){\textbackslash}cdot (1/{\textbackslash}tau){\textasciicircum}\{O({\textbackslash}log(1/{\textbackslash}tau))\}\$, answering an open question posed by Grewal, Iyer, Kretschmer, Liang [40] and Anshu and Arunachalam [6]. Previous protocols ran in time \${\textbackslash}mathrm\{exp\}({\textbackslash}Theta(n))\$ or required \${\textbackslash}tau{\textgreater}{\textbackslash}cos{\textasciicircum}2({\textbackslash}pi/8)\$. States with stabilizer dimension \$n - t\$: We give a protocol that runs in time \$n{\textasciicircum}3{\textbackslash}cdot(2{\textasciicircum}t/{\textbackslash}tau){\textasciicircum}\{O({\textbackslash}log(1/{\textbackslash}epsilon))\}\$, extending recent work on learning quantum states prepared by circuits with few non-Clifford gates, which only applied in the realizable setting where \${\textbackslash}tau = 1\$ [30, 37, 46, 61]. Discrete product states: If \$C = K{\textasciicircum}\{{\textbackslash}otimes n\}\$ for some \${\textbackslash}mu\$-separated discrete set \$K\$ of single-qubit states, we give a protocol that runs in time \$(n/{\textbackslash}mu){\textasciicircum}\{O((1 + {\textbackslash}log (1/{\textbackslash}tau))/{\textbackslash}mu)\}/{\textbackslash}epsilon{\textasciicircum}2\$. This strictly generalizes a prior guarantee which applied to stabilizer product states [39]. For stabilizer product states, we give a further improved protocol that runs in time \$(n{\textasciicircum}2/{\textbackslash}epsilon{\textasciicircum}2){\textbackslash}cdot (1/{\textbackslash}tau){\textasciicircum}\{O({\textbackslash}log(1/{\textbackslash}tau))\}\$. As a corollary, we give the first protocol for estimating stabilizer fidelity, a standard measure of magic for quantum states, to error \${\textbackslash}epsilon\$ in \$n{\textasciicircum}3 {\textbackslash}mathrm\{quasipoly\}(1/{\textbackslash}epsilon)\$ time.},
	language = {en-US},
	urldate = {2024-08-15},
	publisher = {arXiv},
	author = {Chen, Sitan and Gong, Weiyuan and Ye, Qi and Zhang, Zhihan},
	month = aug,
	year = {2024},
	note = {arXiv:2408.06967 [quant-ph]},
	annote = {Comment: 68 pages},
