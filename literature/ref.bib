	issn = {00958956},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0095895606000918},
	doi = {10.1016/j.jctb.2006.06.006},
	abstract = {An integer-valued function f on the set 2V of all subsets of a ﬁnite set V is a connectivity function if it satisﬁes the following conditions: (1) f (X) + f (Y ) ≥ f (X ∩ Y ) + f (X ∪ Y ) for all subsets X, Y of V , (2) f (X) = f (V {\textbackslash} X) for all X ⊆ V , and (3) f (∅) = 0. Branch-width is deﬁned for graphs, matroids, and more generally, connectivity functions. We show that for each constant k, there is a polynomial-time (in {\textbar}V {\textbar}) algorithm to decide whether the branch-width of a connectivity function f is at most k, if f is given by an oracle. This algorithm can be applied to branch-width, carving-width, and rank-width of graphs. In particular, we can recognize matroids M of branch-width at most k in polynomial (in {\textbar}E(M){\textbar}) time if the matroid is given by an independence oracle.},
	language = {en},
	number = {3},
	urldate = {2025-02-14},
