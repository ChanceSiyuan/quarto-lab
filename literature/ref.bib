@article{kitaevAnyonsExactlySolved2006,
	title = {Anyons in an exactly solved model and beyond},
	volume = {321},
	issn = {00034916},
	url = {http://arxiv.org/abs/cond-mat/0506438},
	doi = {10.1016/j.aop.2005.10.005},
	abstract = {A spin 1/2 system on a honeycomb lattice is studied. The interactions between nearest neighbors are of XX, YY or ZZ type, depending on the direction of the link; different types of interactions may differ in strength. The model is solved exactly by a reduction to free fermions in a static \${\textbackslash}mathbb\{Z\}\_\{2\}\$ gauge field. A phase diagram in the parameter space is obtained. One of the phases has an energy gap and carries excitations that are Abelian anyons. The other phase is gapless, but acquires a gap in the presence of magnetic field. In the latter case excitations are non-Abelian anyons whose braiding rules coincide with those of conformal blocks for the Ising model. We also consider a general theory of free fermions with a gapped spectrum, which is characterized by a spectral Chern number \${\textbackslash}nu\$. The Abelian and non-Abelian phases of the original model correspond to \${\textbackslash}nu=0\$ and \${\textbackslash}nu={\textbackslash}pm 1\$, respectively. The anyonic properties of excitation depend on \${\textbackslash}nu{\textbackslash}bmod 16\$, whereas \${\textbackslash}nu\$ itself governs edge thermal transport. The paper also provides mathematical background on anyons as well as an elementary theory of Chern number for quasidiagonal matrices.},
	language = {en-US},
	number = {1},
	urldate = {2025-05-13},
