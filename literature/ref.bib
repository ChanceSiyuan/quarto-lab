}

@article{krishnaLowOverheadMagic2019,
	title = {Towards low overhead magic state distillation},
	volume = {123},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/1811.08461},
	doi = {10.1103/PhysRevLett.123.070507},
	abstract = {Magic state distillation is a resource intensive sub-routine for quantum computation. The ratio of noisy input states to output states with error rate at most \${\textbackslash}epsilon\$ scales as \$O({\textbackslash}log{\textasciicircum}\{{\textbackslash}gamma\}(1/{\textbackslash}epsilon))\$ (Bravyi and Haah, PRA 2012). In a breakthrough paper, Hastings and Haah (PRL 2018) showed that it is possible to construct distillation routines with sub-logarithmic overhead, achieving \${\textbackslash}gamma {\textbackslash}approx 0.6779\$ and falsifying a conjecture that \${\textbackslash}gamma\$ is lower bounded by \$1\$. They then ask whether \${\textbackslash}gamma\$ can be made arbitrarily close to \$0\$. We answer this question in the affirmative for magic state distillation routines using qudits (\$d\$ dimensional quantum systems).},
	number = {7},
	urldate = {2024-05-21},
	journal = {Physical Review Letters},
	author = {Krishna, Anirudh and Tillich, Jean-Pierre},
	month = aug,
	year = {2019},
	note = {arXiv:1811.08461 [quant-ph]},
	pages = {070507},
	annote = {Comment: 4 + 3 pages, comments welcome},
  keywords = {zotero}
}

@article{krishnanvijayanCompilationAlgorithmspecificGraph2024,
	title = {Compilation of algorithm-specific graph states for quantum circuits},
	volume = {9},
	issn = {2058-9565},
	url = {https://iopscience.iop.org/article/10.1088/2058-9565/ad1f39},
	doi = {10.1088/2058-9565/ad1f39},
	abstract = {We present a quantum circuit compiler that prepares an algorithm-specific graph state from quantum circuits described in high level languages, such as Cirq and Q\#. The computation can then be implemented using a series of non-Pauli measurements on this graph state. By compiling the graph state directly instead of starting with a standard lattice cluster state and preparing it over the course of the computation, we are able to better understand the resource costs involved and eliminate wasteful Pauli measurements on the actual quantum device. Access to this algorithm-specific graph state also allows for optimisation over locally equivalent graph states to implement the same quantum circuit. The compiler presented here finds ready application in measurement based quantum computing, NISQ devices and logical level compilation for fault tolerant implementations.},
	language = {en},
	number = {2},
	urldate = {2025-02-21},
	journal = {Quantum Science and Technology},
