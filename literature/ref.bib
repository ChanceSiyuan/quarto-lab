	volume = {94},
	issn = {2469-9926, 2469-9934},
	url = {http://arxiv.org/abs/1510.02443},
	doi = {10.1103/PhysRevA.94.022311},
	abstract = {We explore the question of using an entangled state as a universal resource for implementing quantum measurements by local operations and classical communication (LOCC). We show that for most systems consisting of three or more subsystems, there is no entangled state from the same space that can enable all measurements by LOCC. This is in direct contrast to the bipartite case, where a maximally entangled state is an universal resource. Our results are obtained showing an equivalence between the problem of local state transformation and that of entanglement-assisted local unambiguous state discrimination.},
	language = {en},
	number = {2},
