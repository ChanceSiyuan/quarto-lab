@article{gollakotaHardnessPAClearningStabilizer2022,
	title = {On the {Hardness} of {PAC}-learning {Stabilizer} {States} with {Noise}},
	volume = {6},
	issn = {2521-327X},
	url = {http://arxiv.org/abs/2102.05174},
	doi = {10.22331/q-2022-02-02-640},
	abstract = {We consider the problem of learning stabilizer states with noise in the Probably Approximately Correct (PAC) framework of Aaronson (2007) for learning quantum states. In the noiseless setting, an algorithm for this problem was recently given by Rocchetto (2018), but the noisy case was left open. Motivated by approaches to noise tolerance from classical learning theory, we introduce the Statistical Query (SQ) model for PAC-learning quantum states, and prove that algorithms in this model are indeed resilient to common forms of noise, including classification and depolarizing noise. We prove an exponential lower bound on learning stabilizer states in the SQ model. Even outside the SQ model, we prove that learning stabilizer states with noise is in general as hard as Learning Parity with Noise (LPN) using classical examples. Our results position the problem of learning stabilizer states as a natural quantum analogue of the classical problem of learning parities: easy in the noiseless setting, but seemingly intractable even with simple forms of noise.},
	urldate = {2025-07-27},
	journal = {Quantum},
	author = {Gollakota, Aravind and Liang, Daniel},
	month = feb,
	year = {2022},
	note = {arXiv:2102.05174 [quant-ph]},
	pages = {640},
  keywords = {zotero}
}

@misc{golowichAsymptoticallyGoodQuantum2024,
	title = {Asymptotically {Good} {Quantum} {Codes} with {Transversal} {Non}-{Clifford} {Gates}},
	url = {http://arxiv.org/abs/2408.09254},
	abstract = {We construct quantum codes that support transversal \$CCZ\$ gates over qudits of arbitrary prime power dimension \$q\$ (including \$q=2\$) such that the code dimension and distance grow linearly in the block length. The only previously known construction with such linear dimension and distance required a growing alphabet size \$q\$ (Krishna \& Tillich, 2019). Our codes imply protocols for magic state distillation with overhead exponent \${\textbackslash}gamma={\textbackslash}log(n/k)/{\textbackslash}log(d){\textbackslash}rightarrow 0\$ as the block length \$n{\textbackslash}rightarrow{\textbackslash}infty\$, where \$k\$ and \$d\$ denote the code dimension and distance respectively. It was previously an open question to obtain such a protocol with a contant alphabet size \$q\$. We construct our codes by combining two modular components, namely, (i) a transformation from classical codes satisfying certain properties to quantum codes supporting transversal \$CCZ\$ gates, and (ii) a concatenation scheme for reducing the alphabet size of codes supporting transversal \$CCZ\$ gates. For this scheme we introduce a quantum analogue of multiplication-friendly codes, which provide a way to express multiplication over a field in terms of a subfield. We obtain our asymptotically good construction by instantiating (i) with algebraic-geometric codes, and applying a constant number of iterations of (ii). We also give an alternative construction with nearly asymptotically good parameters (\$k,d=n/2{\textasciicircum}\{O({\textbackslash}log{\textasciicircum}*n)\}\$) by instantiating (i) with Reed-Solomon codes and then performing a superconstant number of iterations of (ii).},
	urldate = {2024-09-21},
	publisher = {arXiv},
	author = {Golowich, Louis and Guruswami, Venkatesan},
	month = aug,
	year = {2024},
	note = {arXiv:2408.09254 [quant-ph]},
  keywords = {zotero}
}

@misc{golowichQuantumLDPCCodes2024,
	title = {Quantum {LDPC} {Codes} with {Transversal} {Non}-{Clifford} {Gates} via {Products} of {Algebraic} {Codes}},
	url = {http://arxiv.org/abs/2410.14662},
	doi = {10.48550/arXiv.2410.14662},
	abstract = {For every integer \$r{\textbackslash}geq 2\$ and every \${\textbackslash}epsilon{\textgreater}0\$, we construct an explicit infinite family of quantum LDPC codes supporting a transversal \$C{\textasciicircum}\{r-1\}Z\$ gate with length \$N\$, dimension \$K{\textbackslash}geq N{\textasciicircum}\{1-{\textbackslash}epsilon\}\$, distance \$D{\textbackslash}geq N{\textasciicircum}\{1/r\}/{\textbackslash}operatorname\{poly\}({\textbackslash}log N)\$, and stabilizer weight \$w{\textbackslash}leq{\textbackslash}operatorname\{poly\}({\textbackslash}log N)\$. The previous state of the art construction (in most parameter regimes) was the \$r\$-dimensional color code, which has only constant dimension \$K=O(1)\$, and otherwise has the same parameters up to polylogarithmic factors. Our construction provides the first known codes with low-weight stabilizers that are capable of magic state distillation with arbitrarily small yield parameter \${\textbackslash}gamma={\textbackslash}log(N/K)/{\textbackslash}log(D){\textgreater}0\$. A classical analogue of transversal \$C{\textasciicircum}\{r-1\}Z\$ gates is given by the multiplication property, which requires component-wise products of classical codewords to belong to another similar code. As a byproduct of our techniques, we also obtain a new construction of classical locally testable codes with such a multiplication property. We construct our codes as products of chain complexes associated to classical LDPC codes, which in turn we obtain by imposing local Reed-Solomon codes on a specific spectral expander that we construct. We prove that our codes support the desired transversal \$C{\textasciicircum}\{r-1\}Z\$ gates by using the multiplication property to combine local circuits based on the topological structure.},
	urldate = {2024-12-10},
	publisher = {arXiv},
	author = {Golowich, Louis and Lin, Ting-Chun},
	month = oct,
	year = {2024},
	note = {arXiv:2410.14662 [quant-ph]},
  keywords = {zotero}
}

