	abstract = {We investigate the computational complexity of estimating the trace of quantum state powers \${\textbackslash}text\{tr\}({\textbackslash}rho{\textasciicircum}q)\$ for an \$n\$-qubit mixed quantum state \${\textbackslash}rho\$, given its state-preparation circuit of size \${\textbackslash}text\{poly\}(n)\$. This quantity is closely related to and often interchangeable with the Tsallis entropy \${\textbackslash}text\{S\}\_q({\textbackslash}rho) = {\textbackslash}frac\{1-{\textbackslash}text\{tr\}({\textbackslash}rho{\textasciicircum}q)\}\{q-1\}\$, where \$q = 1\$ corresponds to the von Neumann entropy. For any non-integer \$q {\textbackslash}geq 1 + {\textbackslash}Omega(1)\$, we provide a quantum estimator for \${\textbackslash}text\{S\}\_q({\textbackslash}rho)\$ with time complexity \${\textbackslash}text\{poly\}(n)\$, exponentially improving the prior best results of \${\textbackslash}exp(n)\$ due to Acharya, Issa, Shende, and Wagner (ISIT 2019), Wang, Guan, Liu, Zhang, and Ying (TIT 2024), and Wang, Zhang, and Li (TIT 2024), and Wang and Zhang (ESA 2024). Our speedup is achieved by introducing efficiently computable uniform approximations of positive power functions into quantum singular value transformation. Our quantum algorithm reveals a sharp phase transition between the case of \$q=1\$ and constant \$q{\textgreater}1\$ in the computational complexity of the Quantum \$q\$-Tsallis Entropy Difference Problem (TsallisQED\$\_q\$), particularly deciding whether the difference \${\textbackslash}text\{S\}\_q({\textbackslash}rho\_0) - {\textbackslash}text\{S\}\_q({\textbackslash}rho\_1)\$ is at least \$0.001\$ or at most \$-0.001\$: - For any \$1+{\textbackslash}Omega(1) {\textbackslash}leq q {\textbackslash}leq 2\$, TsallisQED\$\_q\$ is \${\textbackslash}mathsf\{BQP\}\$-complete, which implies that Purity Estimation is also \${\textbackslash}mathsf\{BQP\}\$-complete. - For any \$1 {\textbackslash}leq q {\textbackslash}leq 1 + {\textbackslash}frac\{1\}\{n-1\}\$, TsallisQED\$\_q\$ is \${\textbackslash}mathsf\{QSZK\}\$-hard, leading to hardness of approximating the von Neumann entropy because \${\textbackslash}text\{S\}\_q({\textbackslash}rho) {\textbackslash}leq {\textbackslash}text\{S\}({\textbackslash}rho)\$, as long as \${\textbackslash}mathsf\{BQP\} {\textbackslash}subsetneq {\textbackslash}mathsf\{QSZK\}\$. The hardness results are derived from reductions based on new inequalities for the quantum \$q\$-Jensen-(Shannon-)Tsallis divergence with \$1{\textbackslash}leq q {\textbackslash}leq 2\$, which are of independent interest.},
	language = {en},
	urldate = {2025-08-16},
	author = {Liu, Yupan and Wang, Qisheng},
	month = jan,
	year = {2025},
	note = {arXiv:2410.13559 [quant-ph]},
	annote = {Comment: 56 pages, 3 tables, 3 algorithms. v2: Minor changes (particularly quantum query complexity lower bound for the hard regime, Theorem 5.8 in the SODA proceedings) and added references},
