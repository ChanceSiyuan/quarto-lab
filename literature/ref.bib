	url = {https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITCS.2023.64},
	doi = {10.4230/LIPICS.ITCS.2023.64},
	abstract = {We show that quantum states with "low stabilizer complexity" can be efficiently distinguished from Haar-random. Specifically, given an n-qubit pure state {\textbar}ψ⟩, we give an efficient algorithm that distinguishes whether {\textbar}ψ⟩ is (i) Haar-random or (ii) a state with stabilizer fidelity at least 1/k (i.e., has fidelity at least 1/k with some stabilizer state), promised that one of these is the case. With black-box access to {\textbar}ψ⟩, our algorithm uses O(k{\textasciicircum}\{12\} log(1/δ)) copies of {\textbar}ψ⟩ and O(n k{\textasciicircum}\{12\} log(1/δ)) time to succeed with probability at least 1-δ, and, with access to a state preparation unitary for {\textbar}ψ⟩ (and its inverse), O(k³ log(1/δ)) queries and O(n k³ log(1/δ)) time suffice.
As a corollary, we prove that ω(log(n)) T-gates are necessary for any Clifford+T circuit to prepare computationally pseudorandom quantum states, a first-of-its-kind lower bound.},
