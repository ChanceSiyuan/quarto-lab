@misc{shangEstimatingQuantumAmplitudes2024,
	title = {Estimating quantum amplitudes can be exponentially improved},
	url = {http://arxiv.org/abs/2408.13721},
	abstract = {Estimating quantum amplitudes is a fundamental task in quantum computing and serves as a core subroutine in numerous quantum algorithms. In this work, we present a novel algorithmic framework for estimating quantum amplitudes by transforming pure states into their matrix forms and encoding them into density matrices and unitary operators. Our framework presents two specific estimation protocols, achieving the standard quantum limit \${\textbackslash}epsilon{\textasciicircum}\{-2\}\$ and the Heisenberg limit \${\textbackslash}epsilon{\textasciicircum}\{-1\}\$, respectively. Our approach significantly reduces the complexity of estimation when states exhibit specific entanglement properties. We also introduce a new technique called channel block encoding for preparing density matrices, providing optimal constructions for gate-based quantum circuits and Hamiltonian simulations. The framework yields considerable advancements contingent on circuit depth or simulation time. A minimum of superpolynomial improvement can be achieved when the depth or the time is within the range of \${\textbackslash}mathcal\{O\}({\textbackslash}text\{poly\}{\textbackslash}log(n))\$. Moreover, in certain extreme cases, an exponential improvement can be realized. Based on our results, various complexity-theoretic implications are discussed.},
	urldate = {2024-09-13},
	publisher = {arXiv},
	author = {Shang, Zhong-Xia and Zhao, Qi},
	month = aug,
	year = {2024},
	note = {arXiv:2408.13721 [quant-ph]},
	annote = {Comment: 26 pages, 3 figures, 2 tables},
  keywords = {zotero}
}

@misc{shangPauliQuantumComputing2024,
	title = {Pauli quantum computing: \${I}\$ as \${\textbar}0{\textbackslash}rangle\$ and \${X}\$ as \${\textbar}1{\textbackslash}rangle\$},
	shorttitle = {Pauli quantum computing},
	url = {http://arxiv.org/abs/2412.03109},
	doi = {10.48550/arXiv.2412.03109},
	abstract = {We propose a new quantum computing formalism named Pauli quantum computing. In this formalism, we use the Pauli basis \$I\$ and \$X\$ on the non-diagonal blocks of density matrices to encode information and treat them as the computational basis \${\textbar}0{\textbackslash}rangle\$ and \${\textbar}1{\textbackslash}rangle\$ in standard quantum computing. There are significant differences between Pauli quantum computing and standard quantum computing from the achievable operations to the meaning of measurements, resulting in novel features and comparative advantages for certain tasks. We will give three examples in particular. First, we show how to design Lindbladians to realize imaginary time evolutions and prepare stabilizer ground states in Pauli quantum computing. These stabilizer states can characterize the coherence in the steady subspace of Lindbladians. Second, for quantum amplitudes of the form \${\textbackslash}langle +{\textbar}{\textasciicircum}\{{\textbackslash}otimes n\}U{\textbar}0{\textbackslash}rangle{\textasciicircum}\{{\textbackslash}otimes n\}\$ with \$U\$ composed of \${\textbackslash}\{H,S,T,{\textbackslash}text\{CNOT\}{\textbackslash}\}\$, as long as the number of Hadamard gates in the unitary circuit \$U\$ is sub-linear \${\textbackslash}mathit\{o\}(n)\$, the gate (time) complexity of estimating such amplitudes using Pauli quantum computing formalism can be exponentially reduced compared with the standard formalism (\${\textbackslash}mathcal\{O\}({\textbackslash}epsilon{\textasciicircum}\{-1\})\$ to \${\textbackslash}mathcal\{O\}(2{\textasciicircum}\{-(n-{\textbackslash}mathit\{o\}(n))/2\}{\textbackslash}epsilon{\textasciicircum}\{-1\})\$). Third, given access to a searching oracle under the Pauli encoding picture manifested as a quantum channel, which mimics the phase oracle in Grover's algorithm, the searching problem can be solved with \${\textbackslash}mathcal\{O\}(n)\$ scaling for the query complexity and \${\textbackslash}mathcal\{O\}({\textbackslash}text\{poly\}(n))\$ scaling for the time complexity. While so, how to construct such an oracle is highly non-trivial and unlikely efficient due to the hardness of the problem.},
	language = {en-US},
	urldate = {2024-12-28},
	publisher = {arXiv},
	author = {Shang, Zhong-Xia},
	month = dec,
	year = {2024},
	note = {arXiv:2412.03109 [quant-ph]},
	annote = {Comment: 8+3 pages, 1 figure},
  keywords = {zotero}
}

@misc{shangPolynomialtimeQuantumAlgorithm2024,
	title = {A polynomial-time quantum algorithm for solving the ground states of a class of classically hard {Hamiltonians}},
	url = {http://arxiv.org/abs/2401.13946},
	abstract = {In this work, we present a polynomial-time quantum algorithm for solving the ground states of a class of classically hard Hamiltonians. The mechanism of the exponential speedup that appeared in our algorithm is different from all existing quantum algorithms. The idea is to introduce a mapping \$f:{\textbackslash}text\{ \}{\textbackslash}rho{\textbackslash}rightarrow {\textbar}{\textbackslash}rho{\textbackslash}rangle\$ to use density matrices to represent pure states. We show that this mapping makes sense by giving an efficient method to obtain the information of \${\textbar}{\textbackslash}rho{\textbackslash}rangle\$ from measurements on \${\textbackslash}rho\$. Under this mapping, the Lindblad master equation (LME) becomes a Schr{\textbackslash}"odinger equation with non-Hermitian Hamiltonian which contains natural imaginary time evolution. The steady state of the LME, therefore, corresponds to the ground state of \$L{\textasciicircum}{\textbackslash}dag L\$ with \$L\$ the Liouvillian operator of the LME. We show the runtime of the LME has the \${\textbackslash}mathcal\{O\}(log({\textbackslash}zeta{\textasciicircum}\{-1\}))\$ scaling with \${\textbackslash}zeta\$ the overlap between the initial state and the ground state compared with the \${\textbackslash}mathcal\{O\}(poly({\textbackslash}zeta{\textasciicircum}\{-1\}))\$ scaling in other algorithms. The Hamiltonians \$L{\textasciicircum}{\textbackslash}dag L\$ are guaranteed to be difficult for classical computers if we believe the simulation of LME is difficult. Further, for any given local Hamiltonian \$H\$ with known ground energy \$E\_0\$, we give a polynomial-time classical procedure to judge and solve whether there exists \$L\$ such that \$H-E\_0=L{\textasciicircum}{\textbackslash}dag L\$. Later, We discuss and analyze several important aspects of the algorithm including the non-linear dynamics that appeared in the algorithm.},
	language = {en},
	urldate = {2024-03-02},
	publisher = {arXiv},
	author = {Shang, Zhong-Xia and Chen, Zi-Han and Lu, Chao-Yang and Pan, Jian-Wei and Chen, Ming-Cheng},
	month = jan,
	year = {2024},
	note = {arXiv:2401.13946 [quant-ph]},
	annote = {Comment: 19 pages, 5 figures},
  keywords = {zotero}
}

