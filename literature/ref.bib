@article{hasanTopologicalInsulators2010,
	title = {Topological {Insulators}},
	volume = {82},
	issn = {0034-6861, 1539-0756},
	url = {http://arxiv.org/abs/1002.3895},
	doi = {10.1103/RevModPhys.82.3045},
	abstract = {Topological insulators are electronic materials that have a bulk band gap like an ordinary insulator, but have protected conducting states on their edge or surface. The 2D topological insulator is a quantum spin Hall insulator, which is a close cousin of the integer quantum Hall state. A 3D topological insulator supports novel spin polarized 2D Dirac fermions on its surface. In this Colloquium article we will review the theoretical foundation for these electronic states and describe recent experiments in which their signatures have been observed. We will describe transport experiments on HgCdTe quantum wells that demonstrate the existence of the edge states predicted for the quantum spin Hall insulator. We will then discuss experiments on Bi\_\{1-x\}Sb\_x, Bi\_2 Se\_3, Bi\_2 Te\_3 and Sb\_2 Te\_3 that establish these materials as 3D topological insulators and directly probe the topology of their surface states. We will then describe exotic states that can occur at the surface of a 3D topological insulator due to an induced energy gap. A magnetic gap leads to a novel quantum Hall state that gives rise to a topological magnetoelectric effect. A superconducting energy gap leads to a state that supports Majorana fermions, and may provide a new venue for realizing proposals for topological quantum computation. We will close by discussing prospects for observing these exotic states, a well as other potential device applications of topological insulators.},
	number = {4},
	urldate = {2025-02-24},
	journal = {Reviews of Modern Physics},
	author = {Hasan, M. Z. and Kane, C. L.},
	month = nov,
	year = {2010},
	note = {arXiv:1002.3895 [cond-mat]},
	pages = {3045--3067},
	annote = {Comment: 23 pages, 20 figures, Published version},
  keywords = {zotero}
}

@article{hashimotoOutoftimeorderCorrelatorsQuantum2017,
	title = {Out-of-time-order correlators in quantum mechanics},
	volume = {2017},
	issn = {1029-8479},
	url = {http://arxiv.org/abs/1703.09435},
	doi = {10.1007/JHEP10(2017)138},
	abstract = {The out-of-time-order correlator (OTOC) is considered as a measure of quantum chaos. We formulate how to calculate the OTOC for quantum mechanics with a general Hamiltonian. We demonstrate explicit calculations of OTOCs for a harmonic oscillator, a particle in a one-dimensional box, a circle billiard and stadium billiards. For the first two cases, OTOCs are periodic in time because of their commensurable energy spectra. For the circle and stadium billiards, they are not recursive but saturate to constant values which are linear in temperature. Although the stadium billiard is a typical example of the classical chaos, an expected exponential growth of the OTOC is not found. We also discuss the classical limit of the OTOC. Analysis of a time evolution of a wavepacket in a box shows that the OTOC can deviate from its classical value at a time much earlier than the Ehrenfest time.},
	number = {10},
	urldate = {2026-02-15},
	journal = {Journal of High Energy Physics},
	author = {Hashimoto, Koji and Murata, Keiju and Yoshii, Ryosuke},
	month = oct,
	year = {2017},
	note = {arXiv:1703.09435 [hep-th]},
	pages = {138},
	annote = {Comment: 30 pages, 13 figures},
  keywords = {zotero}
}

