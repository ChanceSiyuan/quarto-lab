@misc{bakshiHighTemperatureGibbsStates2025,
	title = {High-{Temperature} {Gibbs} {States} are {Unentangled} and {Efficiently} {Preparable}},
	url = {http://arxiv.org/abs/2403.16850},
	doi = {10.48550/arXiv.2403.16850},
	abstract = {We show that thermal states of local Hamiltonians are separable above a constant temperature. Specifically, for a local Hamiltonian \$H\$ on a graph with degree \${\textbackslash}mathfrak\{d\}\$, its Gibbs state at inverse temperature \$β\$, denoted by \$ρ= e{\textasciicircum}\{-βH\}/ {\textbackslash}operatorname\{tr\}(e{\textasciicircum}\{-βH\})\$, is a classical distribution over product states for all \$β{\textless} 1/(c{\textbackslash}mathfrak\{d\})\$, where \$c\$ is a constant. This proof of sudden death of thermal entanglement resolves the fundamental question of whether many-body systems can exhibit entanglement at high temperature. Moreover, we show that we can efficiently sample from the distribution over product states. In particular, for any \$β{\textless} 1/( c {\textbackslash}mathfrak\{d\}{\textasciicircum}2)\$, we can prepare a state \${\textbackslash}varepsilon\$-close to \$ρ\$ in trace distance with a depth-one quantum circuit and \${\textbackslash}operatorname\{poly\}(n, 1/{\textbackslash}varepsilon)\$ classical overhead.},
	urldate = {2025-12-30},
	publisher = {arXiv},
	author = {Bakshi, Ainesh and Liu, Allen and Moitra, Ankur and Tang, Ewin},
	month = feb,
	year = {2025},
	note = {arXiv:2403.16850 [quant-ph]},
	annote = {Ewin Tang: "High-Temperature Gibbs States are Unentangled and Efficiently Preparable" (QIP 2025)
https://www.youtube.com/watch?v=nQsndEQ2-kQ\&t=864s



},
  keywords = {zotero}
}

@article{balasubramanianDiffeomorphismInvariantTensor2026,
	title = {Diffeomorphism invariant tensor networks for 3d gravity},
	volume = {2026},
	issn = {1029-8479},
	url = {https://link.springer.com/10.1007/JHEP05(2026)231},
	doi = {10.1007/JHEP05(2026)231},
	abstract = {Tensor networks prepare states which share many features of states in quantum gravity. However, standard constructions are not diffeomorphism invariant and do not support an algebra of non-commuting area operators. Recently, analogues of both problems were addressed in a tensor network discretization of topological field theories (TFT) with finite or compact gauge groups. Here, we extend this work towards gravity by generalizing to gauge groups that are discrete or continuous, compact or non-compact. Applied to SL(2, ℝ) × SL(2, ℝ) Chern-Simons theory, our construction can be interpreted as building states of three dimensional gravity with a negative cosmological constant. Our tensor networks prepare states which satisfy the constraints of Chern-Simons theory. In metric variables, this implies that the states we construct satisfy the Wheeler-DeWitt equation and momentum constraints, and so are diffeomorphism invariant.},
	language = {en},
	number = {5},
	urldate = {2026-06-21},
	journal = {Journal of High Energy Physics},
	author = {Balasubramanian, Vijay and Cummings, Charlie},
	month = may,
	year = {2026},
	pages = {231},
  keywords = {zotero}
}

@article{baldwinSubspaceBenchmarkingHighfidelity2020,
	title = {Subspace benchmarking high-fidelity entangling operations with trapped ions},
	volume = {2},
	issn = {2643-1564},
	url = {http://arxiv.org/abs/1911.00085},
	doi = {10.1103/PhysRevResearch.2.013317},
	abstract = {We present a new and simplified two-qubit randomized benchmarking procedure that operates only in the symmetric subspace of a pair of qubits and is well suited for benchmarking trapped-ion systems. By performing benchmarking only in the symmetric subspace, we drastically reduce the experimental complexity, number of gates required, and run time. The protocol is demonstrated on trapped ions using collective single-qubit rotations and the Molmer-Sorenson (MS) interaction to estimate an entangling gate error of \$2(1) {\textbackslash}times 10{\textasciicircum}\{-3\}\$. We analyze the expected errors in the MS gate and find that population remains mostly in the symmetric subspace. The errors that mix symmetric and anti-symmetric subspaces appear as leakage and we characterize them by combining our protocol with recently proposed leakage benchmarking. Generalizations and limitations of the protocol are also discussed.},
	number = {1},
	urldate = {2025-10-16},
	journal = {Physical Review Research},
	author = {Baldwin, C. H. and Bjork, B. J. and Gaebler, J. P. and Hayes, D. and Stack, D.},
	month = mar,
	year = {2020},
	note = {arXiv:1911.00085 [quant-ph]},
	pages = {013317},
	annote = {Comment: 16 pages, 4 figures},
  keywords = {zotero}
}

@article{banchiTrainingGaussianBoson2020,
	title = {Training {Gaussian} {Boson} {Sampling} {Distributions}},
	volume = {102},
	issn = {2469-9926, 2469-9934},
	url = {http://arxiv.org/abs/2004.04770},
	doi = {10.1103/PhysRevA.102.012417},
	abstract = {Gaussian Boson Sampling (GBS) is a near-term platform for photonic quantum computing. Applications have been developed which rely on directly programming GBS devices, but the ability to train and optimize circuits has been a key missing ingredient for developing new algorithms. In this work, we derive analytical gradient formulas for the GBS distribution, which can be used to train devices using standard methods based on gradient descent. We introduce a parametrization of the distribution that allows the gradient to be estimated by sampling from the same device that is being optimized. In the case of training using a Kullback-Leibler divergence or log-likelihood cost function, we show that gradients can be computed classically, leading to fast training. We illustrate these results with numerical experiments in stochastic optimization and unsupervised learning. As a particular example, we introduce the variational Ising solver, a hybrid algorithm for training GBS devices to sample ground states of a classical Ising model with high probability.},
	number = {1},
	urldate = {2025-10-14},
	journal = {Physical Review A},
	author = {Banchi, Leonardo and Quesada, Nicolás and Arrazola, Juan Miguel},
	month = jul,
	year = {2020},
	note = {arXiv:2004.04770 [quant-ph]},
	pages = {012417},
	annote = {Comment: 15 pages, 3 figures},
  keywords = {zotero}
}

