@article{yoganathanQuantumAdvantageUnitary2019,
	title = {Quantum advantage of unitary {Clifford} circuits with magic state inputs},
	volume = {475},
	issn = {1364-5021, 1471-2946},
	url = {https://royalsocietypublishing.org/doi/10.1098/rspa.2018.0427},
