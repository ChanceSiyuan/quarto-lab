@article{nietnerAveragecaseComplexityLearning2025,
	title = {On the average-case complexity of learning output distributions of quantum circuits},
	volume = {9},
	issn = {2521-327X},
	url = {http://arxiv.org/abs/2305.05765},
	doi = {10.22331/q-2025-10-13-1883},
	abstract = {In this work, we show that learning the output distributions of brickwork random quantum circuits is average-case hard in the statistical query model. This learning model is widely used as an abstract computational model for most generic learning algorithms. In particular, for brickwork random quantum circuits on \$n\$ qubits of depth \$d\$, we show three main results: - At super logarithmic circuit depth \$d=ω({\textbackslash}log(n))\$, any learning algorithm requires super polynomially many queries to achieve a constant probability of success over the randomly drawn instance. - There exists a \$d=O(n)\$, such that any learning algorithm requires \$Ω(2{\textasciicircum}n)\$ queries to achieve a \$O(2{\textasciicircum}\{-n\})\$ probability of success over the randomly drawn instance. - At infinite circuit depth \$d{\textbackslash}to{\textbackslash}infty\$, any learning algorithm requires \$2{\textasciicircum}\{2{\textasciicircum}\{Ω(n)\}\}\$ many queries to achieve a \$2{\textasciicircum}\{-2{\textasciicircum}\{Ω(n)\}\}\$ probability of success over the randomly drawn instance. As an auxiliary result of independent interest, we show that the output distribution of a brickwork random quantum circuit is constantly far from any fixed distribution in total variation distance with probability \$1-O(2{\textasciicircum}\{-n\})\$, which confirms a variant of a conjecture by Aaronson and Chen.},
	urldate = {2025-11-21},
	journal = {Quantum},
	author = {Nietner, Alexander and Ioannou, Marios and Sweke, Ryan and Kueng, Richard and Eisert, Jens and Hinsche, Marcel and Haferkamp, Jonas},
	month = oct,
	year = {2025},
	note = {arXiv:2305.05765 [quant-ph]},
	pages = {1883},
	annote = {Comment: 62 pages},
	annote = {Comment: 62 pages},
  keywords = {zotero}
}

@article{niffeneggerIntegratedMultiwavelengthControl2020,
	title = {Integrated multi-wavelength control of an ion qubit},
	volume = {586},
	issn = {0028-0836, 1476-4687},
	url = {http://arxiv.org/abs/2001.05052},
	doi = {10.1038/s41586-020-2811-x},
	abstract = {Monolithic integration of control technologies for atomic systems is a promising route to the development of quantum computers and portable quantum sensors [1–4]. Trapped atomic ions form the basis of high-ﬁdelity quantum information processors [5, 6] and high-accuracy optical clocks [7]. However, current implementations rely on free-space optics for ion control, which limits their portability and scalability. Here we demonstrate a surface-electrode ion-trap chip [8, 9] using integrated waveguides and grating couplers, which delivers all the wavelengths of light required for ionization, cooling, coherent operations, and quantum-state preparation and detection of Sr+ qubits. Laser light from violet to infrared is coupled onto the chip via an optical-ﬁber array, creating an inherently stable optical path, which we use to demonstrate qubit coherence that is resilient to platform vibrations. This demonstration of CMOS-compatible integrated-photonic surface-trap fabrication, robust packaging, and enhanced qubit coherence is a key advance in the development of portable trapped-ion quantum sensors and clocks, providing a way toward the complete, individual control of larger numbers of ions in quantum information processing systems.},
	language = {en},
