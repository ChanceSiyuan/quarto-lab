@misc{kumarQuantumClassicalSeparationBoundedResource2025,
	title = {Quantum-{Classical} {Separation} in {Bounded}-{Resource} {Tasks} {Arising} from {Measurement} {Contextuality}},
	url = {http://arxiv.org/abs/2512.02284},
	doi = {10.48550/arXiv.2512.02284},
	abstract = {The prevailing view is that quantum phenomena can be harnessed to tackle certain problems beyond the reach of classical approaches. Quantifying this capability as a quantum-classical separation and demonstrating it on current quantum processors has remained elusive. Using a superconducting qubit processor, we show that quantum contextuality enables certain tasks to be performed with success probabilities beyond classical limits. With a few qubits, we illustrate quantum contextuality with the magic square game, as well as quantify it through a Kochen--Specker--Bell inequality violation. To examine many-body contextuality, we implement the N-player GHZ game and separately solve a 2D hidden linear function problem, exceeding classical success rate in both. Our work proposes novel ways to benchmark quantum processors using contextuality-based algorithms.},
	urldate = {2026-07-15},
	publisher = {arXiv},
	author = {Kumar, Shashwat and Rosenberg, Eliott and Dau, Alejandro Grajales and Cortinas, Rodrigo and Maslov, Dmitri and Oliver, Richard and Zalcman, Adam and Neeley, Matthew and Pagano, Alice and Szasz, Aaron and Drozdov, Ilya and Minev, Zlatko and Gidney, Craig and Yosri, Noureldin and Graaf, Stijn J. de and Maiti, Aniket and Abanin, Dmitry and Acharya, Rajeev and Beni, Laleh Aghababaie and Aigeldinger, Georg and Alcaraz, Ross and Alcaraz, Sayra and Andersen, Trond I. and Ansmann, Markus and Arute, Frank and Arya, Kunal and Askew, Walt and Astrakhantsev, Nikita and Atalaya, Juan and Babbush, Ryan and Ballard, Brian and Bardin, Joseph C. and Bates, Hector and Bengtsson, Andreas and Bigdeli, Martin and Bilmes, Alexander and Bilodeau, Simon and Borjans, Felix and Bourassa, Alexandre and Bovaird, Jenna and Bowers, Dylan and Brill, Leon and Brooks, Peter and Broughton, Michael and Browne, David A. and Buchea, Brett and Buckley, Bob B. and Burger, Tim and Burkett, Brian and Bushnell, Nicholas and Busnaina, Jamal and Cabrera, Anthony and Campero, Juan and Chang, Hung-Shen and Chen, Silas and Chen, Zijun and Chiaro, Ben and Chih, Liang-Ying and Claes, Jahan and Cleland, Agnetta Y. and Cochrane, Bryan and Cockrell, Matt and Cogan, Josh and Collins, Roberto and Conner, Paul and Cook, Harold and Courtney, William and Crook, Alexander L. and Curtin, Ben and Das, Sayan and Lorenzo, Laura De and Demura, Sean and Paolo, Agustin Di and Donohoe, Paul and Dunsworth, Andrew and Ehimhen, Valerie and Eickbusch, Alec and Elbag, Aviv Moshe and Ella, Lior and Elzouka, Mahmoud and Enriquez, David and Erickson, Catherine and Ferreira, Vinicius S. and Flores, Marcos and Burgos, Leslie Flores and Forati, Ebrahim and Ford, Jeremiah and Fowler, Austin G. and Foxen, Brooks and Fukami, Masaya and Fung, Alan Wing Lun and Fuste, Lenny and Ganjam, Suhas and Garcia, Gonzalo and Garrick, Christopher and Gasca, Robert and Gehring, Helge and Genois, Élie and Giang, William and Gilboa, Dar and Goeders,