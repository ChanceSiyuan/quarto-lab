{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "outputHashes": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "instance.json",
        "hx.json",
        "hz.json",
        "qec_code_quantum_tanner_spec.json"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposalProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "proposal_fingerprint",
        "validator_fingerprint",
        "candidate_fingerprint",
        "materialization_manifest",
        "qec_code_spec_path",
        "output_hashes",
        "materializer_version",
        "exact_distance_status",
        "materialization_run"
      ],
      "properties": {
        "proposal_id": { "type": "string", "minLength": 1 },
        "proposal_fingerprint": { "type": "string", "minLength": 1 },
        "validator_fingerprint": { "type": "string", "minLength": 1 },
        "candidate_fingerprint": { "type": "string", "minLength": 1 },
        "materialization_manifest": { "type": "string", "minLength": 1 },
        "qec_code_spec_path": { "type": "string", "minLength": 1 },
        "output_hashes": { "$ref": "#/$defs/outputHashes" },
        "materializer_version": { "type": "string", "minLength": 1 },
        "exact_distance_status": { "const": "unknown" },
        "materialization_run": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "proposal-derived" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["proposal"]
          }
        }
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "strategy": { "enum": ["grid", "random", "adaptive"] },
        "proposal": { "$ref": "#/$defs/proposalProvenance" }
      }
    },
    "parameterCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "code_family", "parameters", "provenance"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "code_family": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "integer" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "explicitInstanceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "code_family", "instance_path", "provenance"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "code_family": { "type": "string", "minLength": 1 },
        "instance_path": { "type": "string", "minLength": 1 },
        "upper_bound_witness_path": { "type": "string", "minLength": 1 },
        "upper_bound_payload": { "$ref": "#/$defs/upperBoundPayload" },
        "upper_bound_payload_path": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "upperBoundPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "bound_type", "upper_bound"],
      "properties": {
        "status": { "const": "completed" },
        "method": { "type": "string", "minLength": 1 },
        "bound_type": { "const": "upper" },
        "upper_bound": { "type": "integer", "minimum": 1 },
        "basis": { "enum": ["x", "z"] }
      }
    },
    "catalogCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "code_family", "fixture_catalog_path", "provenance"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "code_family": { "type": "string", "minLength": 1 },
        "fixture_catalog_path": { "type": "string", "minLength": 1 },
        "upper_bound_witness_path": { "type": "string", "minLength": 1 },
        "upper_bound_payload": { "$ref": "#/$defs/upperBoundPayload" },
        "upper_bound_payload_path": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  },
  "required": ["campaign_id", "mode", "candidate_specs"],
  "properties": {
    "campaign_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["explicit_list"] },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["grid", "random", "adaptive"] },
        "params": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "integer" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "candidate_specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/parameterCandidate" },
          { "$ref": "#/$defs/explicitInstanceCandidate" },
          { "$ref": "#/$defs/catalogCandidate" }
        ]
      }
    }
  }
}
