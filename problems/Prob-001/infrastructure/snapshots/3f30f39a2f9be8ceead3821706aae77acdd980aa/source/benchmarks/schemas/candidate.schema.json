{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "outputHashes": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "instance.json",
        "hx.json",
        "hz.json",
        "qec_code_quantum_tanner_spec.json"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposalProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "proposal_fingerprint",
        "validator_fingerprint",
        "candidate_fingerprint",
        "materialization_manifest",
        "qec_code_spec_path",
        "output_hashes",
        "materializer_version",
        "exact_distance_status",
        "materialization_run"
      ],
      "properties": {
        "proposal_id": { "type": "string", "minLength": 1 },
        "proposal_fingerprint": { "type": "string", "minLength": 1 },
        "validator_fingerprint": { "type": "string", "minLength": 1 },
        "candidate_fingerprint": { "type": "string", "minLength": 1 },
        "materialization_manifest": { "type": "string", "minLength": 1 },
        "qec_code_spec_path": { "type": "string", "minLength": 1 },
        "output_hashes": { "$ref": "#/$defs/outputHashes" },
        "materializer_version": { "type": "string", "minLength": 1 },
        "exact_distance_status": { "const": "unknown" },
        "materialization_run": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    }
  },
  "required": [
    "candidate_id",
    "campaign_id",
    "run_id",
    "code_family",
    "parameters",
    "provenance",
    "status"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "code_family": { "type": "string", "minLength": 1 },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "proposal-derived" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["proposal"]
          }
        }
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "strategy": { "enum": ["grid", "random", "adaptive"] },
        "proposal": { "$ref": "#/$defs/proposalProvenance" }
      }
    },
    "status": { "enum": ["placeholder", "evaluated", "crashed"] }
  }
}
