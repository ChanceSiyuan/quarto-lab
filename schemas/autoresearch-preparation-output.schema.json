{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autoresearch preparation output",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "summary", "manifestPath", "question"],
      "properties": {
        "outcome": { "const": "prepared" },
        "summary": { "type": "string", "minLength": 1 },
        "manifestPath": { "const": "infrastructure.json" },
        "question": { "const": null }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "summary", "manifestPath", "question"],
      "properties": {
        "outcome": { "const": "needs_input" },
        "summary": { "type": "string", "minLength": 1 },
        "manifestPath": { "const": null },
        "question": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "prompt", "answerType", "choices"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
                "prompt": { "type": "string", "minLength": 1 },
                "answerType": { "const": "text" },
                "choices": { "const": [] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "prompt", "answerType", "choices"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
                "prompt": { "type": "string", "minLength": 1 },
                "answerType": { "const": "choice" },
                "choices": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        }
      }
    }
  ]
}
