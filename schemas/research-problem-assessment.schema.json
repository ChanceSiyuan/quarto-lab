{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-loop.local/schemas/research-problem-assessment.schema.json",
  "title": "Research Loop Research Problem Assessment Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "language", "knowledgeResolution", "assessment", "clarification"],
  "properties": {
    "outcome": { "type": "string", "enum": ["assessment", "needs_input"] },
    "language": { "type": "string", "minLength": 2 },
    "knowledgeResolution": { "$ref": "#/$defs/knowledgeResolution" },
    "assessment": { "anyOf": [{ "$ref": "#/$defs/assessmentV1" }, { "$ref": "#/$defs/assessmentV2" }, { "type": "null" }] },
    "clarification": { "anyOf": [{ "$ref": "#/$defs/clarification" }, { "type": "null" }] }
  },
  "$defs": {
    "scoreInterval": { "type": "object", "additionalProperties": false, "required": ["min", "estimate", "max"], "properties": { "min": { "type": "number", "minimum": 0, "maximum": 100 }, "estimate": { "type": "number", "minimum": 0, "maximum": 100 }, "max": { "type": "number", "minimum": 0, "maximum": 100 } } },
    "dimensionScoreInterval": { "type": "object", "additionalProperties": false, "required": ["min", "estimate", "max"], "properties": { "min": { "type": "number", "minimum": 0, "maximum": 5 }, "estimate": { "type": "number", "minimum": 0, "maximum": 5 }, "max": { "type": "number", "minimum": 0, "maximum": 5 } } },
    "knowledgeResolution": { "type": "object", "additionalProperties": false, "required": ["query", "status", "topic", "orderedFiles"], "properties": { "query": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["match", "no-match", "ambiguous"] }, "topic": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "orderedFiles": { "type": "array", "items": { "type": "string" } } } },
    "evidenceRef": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "locator", "summary"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["knowledge", "problem", "resolver", "unknown"] }, "path": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "locator": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "summary": { "type": "string" } } },
    "dimension": { "type": "object", "additionalProperties": false, "required": ["id", "label", "weight", "score", "evidenceState", "rationale", "evidenceRefs"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "weight": { "type": "number" }, "score": { "$ref": "#/$defs/dimensionScoreInterval" }, "evidenceState": { "type": "string", "enum": ["supported", "inferred", "unknown"] }, "rationale": { "type": "string" }, "evidenceRefs": { "type": "array", "items": { "type": "string" } } } },
    "verdict": { "type": "object", "additionalProperties": false, "required": ["label", "provisional", "possibleLabels"], "properties": { "label": { "type": "string", "enum": ["DO_NOW", "REFRAME", "NOT_AUTORESEARCH", "DEFER"] }, "provisional": { "type": "boolean" }, "possibleLabels": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["DO_NOW", "REFRAME", "NOT_AUTORESEARCH", "DEFER"] } } } },
    "scores": { "type": "object", "additionalProperties": false, "required": ["researchValue", "autoresearchSuitability", "combined"], "properties": { "researchValue": { "$ref": "#/$defs/scoreInterval" }, "autoresearchSuitability": { "$ref": "#/$defs/scoreInterval" }, "combined": { "$ref": "#/$defs/scoreInterval" } } },
    "confidence": { "type": "object", "additionalProperties": false, "required": ["level", "rationale"], "properties": { "level": { "type": "string", "enum": ["high", "medium", "low"] }, "rationale": { "type": "string", "minLength": 1 } } },
    "dimensions": { "type": "object", "additionalProperties": false, "required": ["researchValue", "autoresearchSuitability"], "properties": { "researchValue": { "type": "array", "items": { "$ref": "#/$defs/dimension" } }, "autoresearchSuitability": { "type": "array", "items": { "$ref": "#/$defs/dimension" } } } },
    "recommendedReframe": { "type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": { "kind": { "type": "string", "enum": ["bounded", "none"] }, "text": { "type": "string", "minLength": 1 } } },
    "assessmentCore": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "normalizedProblem", "verdict", "recommendation", "scores", "confidence", "dimensions", "largestBottleneck", "recommendedReframe", "informationGaps", "evidence"], "properties": { "schemaVersion": { "type": "integer" }, "normalizedProblem": { "type": "string", "minLength": 1 }, "verdict": { "$ref": "#/$defs/verdict" }, "recommendation": { "type": "string", "enum": ["proceed", "reframe", "reject", "defer"] }, "scores": { "$ref": "#/$defs/scores" }, "confidence": { "$ref": "#/$defs/confidence" }, "dimensions": { "$ref": "#/$defs/dimensions" }, "largestBottleneck": { "type": "string", "minLength": 1 }, "recommendedReframe": { "$ref": "#/$defs/recommendedReframe" }, "informationGaps": { "type": "array", "items": { "type": "string" } }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } } } },
    "assessmentV1": { "allOf": [{ "$ref": "#/$defs/assessmentCore" }, { "type": "object", "properties": { "schemaVersion": { "type": "integer", "const": 1 } } }] },
    "valuationInterval": { "type": "object", "additionalProperties": false, "required": ["low", "base", "high"], "properties": { "low": { "type": "number" }, "base": { "type": "number" }, "high": { "type": "number" } } },
    "quantitativeValue": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": { "state": { "type": "string", "const": "unknown" }, "reason": { "type": "string", "minLength": 1 } } }, { "type": "object", "additionalProperties": false, "required": ["state", "interval", "unit", "visibility", "evidenceState", "evidenceTier", "sourceIds", "sources"], "properties": { "state": { "type": "string", "const": "known" }, "interval": { "$ref": "#/$defs/valuationInterval" }, "unit": { "type": "string", "minLength": 1 }, "visibility": { "type": "string", "enum": ["public", "private"] }, "evidenceState": { "type": "string", "enum": ["reported", "inferred"] }, "evidenceTier": { "type": "string", "enum": ["primary", "authoritative-secondary", "vendor-or-news", "assumption"] }, "sourceIds": { "type": "array", "items": { "type": "string" } }, "sources": { "type": "array", "items": { "type": "object" } } } }] },
    "scientificAttention": { "type": "object", "additionalProperties": false, "required": ["value", "momentum", "coverage", "concentration", "warnings"], "properties": { "value": { "$ref": "#/$defs/quantitativeValue" }, "momentum": { "$ref": "#/$defs/quantitativeValue" }, "coverage": { "type": "number", "minimum": 0, "maximum": 1 }, "concentration": { "type": "number", "minimum": 0, "maximum": 1 }, "warnings": { "type": "array", "items": { "type": "string" } } } },
    "scoreAnchor": { "type": "object", "additionalProperties": false, "required": ["dimensionId", "recommended", "evidenceIds", "override"], "properties": { "dimensionId": { "type": "string" }, "recommended": { "$ref": "#/$defs/dimensionScoreInterval" }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "override": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } }] }, "momentumAdjustment": { "type": "number", "minimum": -0.25, "maximum": 0.25 } } },
    "sensitivity": { "type": "object", "additionalProperties": false, "required": ["id", "label", "swing"], "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "swing": { "type": "number" } } },
    "quantitativeEvidence": { "type": "object", "additionalProperties": false, "required": ["domain", "quantumArea", "snapshot", "scientificAttention", "technicalFeasibility", "socialValue", "capturableValue", "informationValue", "scoreAnchors", "sensitivity", "assumptions", "warnings"], "properties": { "domain": { "type": "string", "const": "quantum-computing" }, "quantumArea": { "type": "string", "enum": ["algorithms-and-applications", "error-correction-and-fault-tolerance", "compilation-and-architecture", "hardware-and-control", "resource-estimation-and-benchmarks", "classical-simulation-and-verification"] }, "snapshot": { "type": "object", "additionalProperties": false, "required": ["snapshotId", "contentHash", "createdAt", "freshness", "visibility"], "properties": { "snapshotId": { "type": "string", "pattern": "^\\d{8}T\\d{6}Z-[a-f0-9]{12}$" }, "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "createdAt": { "type": "string", "format": "date-time" }, "freshness": { "type": "string", "enum": ["fresh", "stale"] }, "visibility": { "type": "string", "enum": ["public", "private"] } } }, "scientificAttention": { "$ref": "#/$defs/scientificAttention" }, "technicalFeasibility": { "$ref": "#/$defs/quantitativeValue" }, "socialValue": { "$ref": "#/$defs/quantitativeValue" }, "capturableValue": { "$ref": "#/$defs/quantitativeValue" }, "informationValue": { "$ref": "#/$defs/quantitativeValue" }, "scoreAnchors": { "type": "array", "items": { "$ref": "#/$defs/scoreAnchor" } }, "sensitivity": { "type": "array", "items": { "$ref": "#/$defs/sensitivity" } }, "assumptions": { "type": "array", "items": { "type": "string" } }, "warnings": { "type": "array", "items": { "type": "string" } } } },
    "assessmentV2": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "normalizedProblem", "verdict", "recommendation", "scores", "confidence", "dimensions", "largestBottleneck", "recommendedReframe", "informationGaps", "evidence", "quantitativeEvidence", "visibility"], "properties": { "schemaVersion": { "type": "integer", "const": 2 }, "normalizedProblem": { "type": "string", "minLength": 1 }, "verdict": { "$ref": "#/$defs/verdict" }, "recommendation": { "type": "string", "enum": ["proceed", "reframe", "reject", "defer"] }, "scores": { "$ref": "#/$defs/scores" }, "confidence": { "$ref": "#/$defs/confidence" }, "dimensions": { "$ref": "#/$defs/dimensions" }, "largestBottleneck": { "type": "string", "minLength": 1 }, "recommendedReframe": { "$ref": "#/$defs/recommendedReframe" }, "informationGaps": { "type": "array", "items": { "type": "string" } }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } }, "quantitativeEvidence": { "$ref": "#/$defs/quantitativeEvidence" }, "visibility": { "type": "string", "enum": ["public", "private"] } } },
    "clarification": { "type": "object", "additionalProperties": false, "required": ["query", "reason", "alternatives"], "properties": { "query": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "alternatives": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["page", "topic", "title", "matchKind"], "properties": { "page": { "type": "string", "minLength": 1 }, "topic": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "matchKind": { "type": "string", "minLength": 1 } } } } } }
  }
}
