{
  "name": "research-loop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node .research-loop/tooling/scripts/dev-problem-index.mjs",
    "autoresearch:service": "node .research-loop/tooling/scripts/local-autoresearch-service.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:test": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --host 127.0.0.1 --port 4173",
    "build": "node .research-loop/tooling/scripts/build-problem-index.mjs --public --reserve-id Prob-000 && npm run knowledge:build && npm run build:app",
    "build:app": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:e2e": "node --import tsx .research-loop/tooling/scripts/build-e2e-fixture.ts",
    "pages:build": "node .research-loop/tooling/scripts/build-pages-showcase.mjs",
    "knowledge:check": "node --import tsx .research-loop/tooling/scripts/knowledge.ts check",
    "knowledge:resolve": "node --import tsx .research-loop/tooling/scripts/knowledge.ts resolve",
    "knowledge:build": "node --import tsx .research-loop/tooling/scripts/knowledge.ts build",
    "knowledge:preview": "node --import tsx .research-loop/tooling/scripts/knowledge.ts preview",
    "draft:preview": "node --import tsx .research-loop/tooling/scripts/draft-preview.ts",
    "draft:check": "node --import tsx .research-loop/tooling/scripts/draft-check.ts",
    "skills:ensure-sci-brain": "node .research-loop/tooling/scripts/ensure-sci-brain.mjs",
    "literature:index": "node --import tsx .research-loop/tooling/scripts/literature.ts index",
    "literature:fetch": "node --import tsx .research-loop/tooling/scripts/literature.ts fetch",
    "literature:sync": "node --import tsx .research-loop/tooling/scripts/literature.ts sync",
    "migration:verify": "node --import tsx .research-loop/tooling/scripts/migrate-quantum-harness.ts verify",
    "problem:import:autoqec-css-distance": "node .research-loop/tooling/scripts/import-autoqec-css-distance.mjs import",
    "problem:import:verify": "node .research-loop/tooling/scripts/import-autoqec-css-distance.mjs verify",
    "problem:index": "node .research-loop/tooling/scripts/build-problem-index.mjs --reserve-id Prob-000",
    "problem:publish": "node .research-loop/tooling/scripts/publish-problem.mjs",
    "qec-portfolio:register": "node .research-loop/tooling/scripts/register-qec-portfolio.mjs",
    "qec-portfolio:run": "node .research-loop/tooling/scripts/run-qec-portfolio.mjs",
    "qec-portfolio:verify": "node .research-loop/tooling/scripts/verify-qec-portfolio.mjs",
    "qec:backfill:point-estimates": "node .research-loop/tooling/scripts/backfill-qec-point-estimates.mjs",
    "lint": "node .research-loop/tooling/scripts/build-problem-index.mjs --reserve-id Prob-000 && eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .generated",
    "test:unit": "node --import tsx --test .research-loop/tests/knowledge/*.test.ts .research-loop/tests/migration/*.test.ts .research-loop/tests/literature/*.test.ts .research-loop/tests/drafts/*.test.ts .research-loop/tests/agent/*.test.ts",
    "test:unit:problems": "node --test .research-loop/tests/static-example-content.test.mjs .research-loop/tests/example-research.test.mjs .research-loop/tests/example-valuation.test.mjs .research-loop/tests/qh127-research.test.mjs .research-loop/tests/problem-schema.test.mjs .research-loop/tests/problem-indexer.test.mjs .research-loop/tests/dev-problem-index.test.mjs .research-loop/tests/problem-repository.test.mjs .research-loop/tests/codex-launch.test.mjs .research-loop/tests/sci-brain-installer.test.mjs .research-loop/tests/problem-presentation.test.mjs .research-loop/tests/problem-view-state.test.mjs .research-loop/tests/imported-research-schema.test.mjs .research-loop/tests/research-indexer.test.mjs .research-loop/tests/problem-routes-research.test.mjs .research-loop/tests/autoqec-css-distance-importer.test.mjs .research-loop/tests/autoqec-css-distance-verify.test.mjs .research-loop/tests/problem-draft-contract.test.mjs .research-loop/tests/problem-draft-publisher.test.mjs .research-loop/tests/valuation-contract.test.mjs .research-loop/tests/valuation-formulas.test.mjs .research-loop/tests/valuation-snapshot.test.mjs .research-loop/tests/valuation-privacy.test.mjs .research-loop/tests/valuation-openalex.test.mjs .research-loop/tests/valuation-citations.test.mjs .research-loop/tests/valuation-codex-adapter.test.mjs .research-loop/tests/valuation-job-manager.test.mjs .research-loop/tests/assessment-policy.test.mjs .research-loop/tests/assessment-contract.test.mjs .research-loop/tests/assessment-artifacts.test.mjs .research-loop/tests/assessment-staleness.test.mjs .research-loop/tests/assessment-report.test.mjs .research-loop/tests/assessment-codex-adapter.test.mjs .research-loop/tests/assessment-job-manager.test.mjs .research-loop/tests/assessment-local-service.test.mjs .research-loop/tests/assessment-view-model.test.mjs .research-loop/tests/assessment-point-estimates.test.mjs .research-loop/tests/qec-portfolio-catalog.test.mjs .research-loop/tests/qec-portfolio-registration.test.mjs .research-loop/tests/qec-portfolio-valuation.test.mjs .research-loop/tests/qec-portfolio-openalex-retry.test.mjs .research-loop/tests/qec-portfolio-batch.test.mjs .research-loop/tests/qec-portfolio-reader.test.mjs .research-loop/tests/qec-portfolio-page.test.mjs .research-loop/tests/qec-point-estimate-backfill.test.mjs .research-loop/tests/qec-valuation-only-refresh.test.mjs .research-loop/tests/autoresearch-preparation-contract.test.mjs .research-loop/tests/autoresearch-paths.test.mjs .research-loop/tests/autoresearch-process.test.mjs .research-loop/tests/autoresearch-oci-process.test.mjs .research-loop/tests/autoresearch-oci.integration.test.mjs .research-loop/tests/autoresearch-oci-required-mode.test.mjs .research-loop/tests/autoresearch-codex-preparation.test.mjs .research-loop/tests/autoresearch-preflight.test.mjs .research-loop/tests/autoresearch-artifact-store.test.mjs .research-loop/tests/autoresearch-job-store.test.mjs .research-loop/tests/autoresearch-scheduler.test.mjs .research-loop/tests/autoresearch-preparation-worker.test.mjs .research-loop/tests/autoresearch-local-service.test.mjs .research-loop/tests/autoresearch-view-model.test.mjs",
    "test:autoresearch:oci-containment": "AUTORESEARCH_REQUIRE_OCI_CONTAINMENT=1 node --test .research-loop/tests/autoresearch-oci.integration.test.mjs",
    "test:autoresearch:preparation": "node --test .research-loop/tests/autoresearch-preparation-contract.test.mjs .research-loop/tests/autoresearch-paths.test.mjs .research-loop/tests/autoresearch-process.test.mjs .research-loop/tests/autoresearch-oci-process.test.mjs .research-loop/tests/autoresearch-oci.integration.test.mjs .research-loop/tests/autoresearch-codex-preparation.test.mjs .research-loop/tests/autoresearch-preflight.test.mjs .research-loop/tests/autoresearch-artifact-store.test.mjs .research-loop/tests/autoresearch-job-store.test.mjs .research-loop/tests/autoresearch-scheduler.test.mjs .research-loop/tests/autoresearch-preparation-worker.test.mjs .research-loop/tests/autoresearch-local-service.test.mjs .research-loop/tests/autoresearch-view-model.test.mjs",
    "test:pages": "npm run pages:build && node --test .research-loop/tests/pages-showcase.test.mjs",
    "test:rendered": "node --test .research-loop/tests/rendered-html.test.mjs .research-loop/tests/built-static-assets.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:assessment": "playwright test --config playwright.assessment.config.ts",
    "test:e2e:autoresearch": "playwright test --config playwright.autoresearch.config.ts",
    "test": "npm run lint && npm run test:unit:problems && npm run test:unit && npm run build && npm run test:rendered && npm run test:pages && npm run test:e2e && npm run test:e2e:assessment && npm run test:e2e:autoresearch && npm run build"
  },
  "dependencies": {
    "@retorquere/bibtex-parser": "10.0.0",
    "mdast-util-to-string": "4.0.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remark-parse": "11.0.0",
    "tar": "7.5.19",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
